{% liquid
  assign color_label = 'color,colour,couleur,colore,farbe,색,色,färg,farve' | split: ','
  assign collection_title = collection.title | downcase

  # plp_layout is passed only by main-collection-product-grid on the default
  # collection template. Every other caller keeps the original card.
  # A pattern is the part of the colour value before the brackets:
  # "Tigers Eye (Natural)" -> "tigers eye". Values without brackets
  # ("Slate") share the blank pattern, so those groups keep all their swatches.
  assign current_pattern = ''
  assign card_color_value = ''
  assign card_size_value = ''
  if plp_layout
    assign card_variant = product_card_product.selected_or_first_available_variant
    for option in product_card_product.options_with_values
      assign option_name = option.name | downcase
      if color_label contains option_name
        assign card_color_value = card_variant.options[forloop.index0]
      elsif option_name == 'size'
        assign card_size_value = card_variant.options[forloop.index0]
      endif
    endfor
    if card_color_value contains ' ('
      assign current_pattern = card_color_value | split: ' (' | first | strip | downcase
    endif
  endif

  capture color_swatch_list
    assign swatch_count = 1
    assign hidden_swatches = 0
    for product in collection.products
      for option in product.options_with_values
        assign option_name = option.name | downcase
        if color_label contains option_name or option_name == 'style'
          assign option_index = 'option' | append: forloop.index
          for value in option.values
            if plp_layout
              assign value_pattern = ''
              if value contains ' ('
                assign value_pattern = value | split: ' (' | first | strip | downcase
              endif
              if value_pattern != current_pattern
                continue
              endif
            endif

            assign matched_variant = product.variants | where: 'title', value
            if plp_layout
              # A variant title is "Colour / Size" on two-option products, so match on
              # the option itself, and reset the link so a swatch never inherits the
              # previous product's URL.
              assign matched_variant = product.variants | where: option_index, value
              assign swatch_link = blank
            endif

            if product == product_card_product
              assign active_swatch = product
              if matched_variant != blank
                assign active_swatch_link = matched_variant[0].url
              endif

              assign element_classes = element_classes | append: ' product-card__active-swatch'
              assign active_swatch_file_name = value | remove: "(" | remove: ")" | handle | append: '.png'
              assign active_swatch_tooltip_value = value
            else
              if matched_variant != blank
                assign swatch_link = matched_variant[0].url
              endif

              if swatch_count > 3
                assign element_classes = 'product-card__swatch hidden'
                assign hidden_swatches = hidden_swatches | plus: 1
              else
                assign element_classes = 'product-card__swatch'
              endif

              assign swatch_file_name = value | remove: "(" | remove: ")" | handle | append: '.png'
              assign swatch_image = images[swatch_file_name]

              echo "<a href='"
              echo swatch_link | default: product.variants[0].url
              echo "' class='"
              echo element_classes
              echo "'"
              echo " aria-label='"
              echo value | escape
              echo "'"
              echo "style='background-image: url("
              echo swatch_file_name | file_img_url: '60x60'
              echo ")' data-tooltip='"
              echo value | escape
              echo "'></a>"
              assign swatch_count = swatch_count | plus: 1
            endif
          endfor
        endif
      endfor
    endfor
    if hidden_swatches > 0
      echo '<button data-hidden-swatches class="body-xs blue">'
      echo '+'
      echo hidden_swatches
      echo ' more'
      echo '</button>'
    endif
  endcapture

  if plp_layout
    # Only the swatches rendered above count: other patterns were skipped.
    assign card_color_count = swatch_count | minus: 1
    if active_swatch != blank
      assign card_color_count = card_color_count | plus: 1
    endif

    # Line 1: "The Innerweave - Tigers Eye (Natural) / 3 x 5 Doormat" -> "The Innerweave Collection".
    if product_card_product.title contains ' - '
      assign card_line = product_card_product.title | split: ' - ' | first | strip
    elsif collection.title != blank
      assign card_line = collection.title | split: ' | ' | first | strip
    else
      assign card_line = product_card_product.title | split: ' / ' | first | strip
    endif
    assign card_line_downcase = card_line | downcase
    unless card_line_downcase contains 'collection'
      assign card_line = card_line | append: ' Collection'
    endunless

    # Line 2: the dimensions from the Size option ("5 x 7 Area Mat" -> "5 x 7"), then the colour.
    # Size values without dimensions ("Doormat", "Runner") add nothing.
    assign card_size = ''
    assign size_tokens = card_size_value | split: ' '
    for token in size_tokens
      assign token_downcase = token | downcase
      if token_downcase == 'x' and forloop.first == false and forloop.last == false
        assign prev_index = forloop.index0 | minus: 1
        assign size_width = size_tokens[prev_index]
        assign size_length = size_tokens[forloop.index]
        assign size_width_number = size_width | plus: 0
        assign size_length_number = size_length | plus: 0
        if size_width_number > 0 and size_length_number > 0
          assign card_size = size_width | append: ' x ' | append: size_length
          break
        endif
      endif
    endfor

    assign card_name = card_color_value
    if card_name == blank
      assign card_name = product_card_product.title | split: ' - ' | last | split: ' / ' | first | strip
    endif
    if card_size != blank
      assign card_name = card_size | append: ' ' | append: card_name
    endif
  endif
%}

<grouped-product-card data-collection-id="{{collection.id}}">
  <div class="product-card {% if simple_card == true %}product-card-simple{% endif %}">
    {% comment %}
      <div class="product-card__image">
        <div class="swiper product-card__image-swiper">
          <div class="swiper-wrapper">
            {% for i in product_card_product.images %}
              <div class="swiper-slide">
                {% render 'lazy-image', image: i, fill: true %}
              </div>
            {% endfor %}
          </div>
          <div class="swiper-pagination"></div>
        </div>

        {% if product_card_product.compare_at_price > product_card_product.price %}
          {% assign price_change = product_card_product.compare_at_price | minus: product_card_product.price %}
          {% assign percent_discount = price_change | times: 100 | divided_by: product_card_product.compare_at_price %}
        <div class="product-card__discount-flag">
          <div class="product-card__discount-amount">{{ percent_discount }} <span>%</span></div>
          <span>off</span>
        </div>
        {% endif %}
      </div>
    {% endcomment %}
    <div class="product-card__image">
      <a href="{{ product_card_product.url }}">
        {%- liquid
          assign is_eager = false
          if card_index != blank and card_index <= 4
            assign is_eager = true
          endif
        -%}
        {% render 'lazy-image', image: product_card_product.featured_media, fade: true, classes: 'img-fill', aria-label: "image", eager: is_eager, widthI: 800, sizes: '(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 45vw', widths: '200, 360, 535, 750, 800' %}
        {% if product_card_product.media[1] != null %}
          {% render 'deferred-hover-image', image: product_card_product.media[1], classes: 'img-fill', sizes: '(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 45vw' %}
        {% endif %}

        {% assign lowercase_tags = product_card_product.tags | join: '~~~' | downcase | split: '~~~' %}

        {% unless hide_tag == true %}
          {% comment %} {% if product_card_product.first_available_variant.metafields.filters.use != blank %}
            <div class="aa product-card__image-label body-xs {% if template.suffix == 'last-chance' %}hidden{% endif %}">
            {{ product_card_product.first_available_variant.metafields.filters.use.value }}
            </div>   {% endcomment %}
          {% if lowercase_tags contains 'final sale' %}
          <div class="product-card__image-label body-xs">
            Final Sale
          </div>
        {% elsif lowercase_tags contains 'best seller' %}
          <div class="product-card__image-label body-xs {% if template.suffix == 'last-chance' or template.suffix == 'best-sellers' or template.suffix == 'badge-reduction' %}hidden{% endif %}">
            Best Seller
          </div>
          {% elsif lowercase_tags contains 'indoor' and lowercase_tags contains 'outdoor' %}
            <div class="product-card__image-label body-xs {% if template.suffix == 'last-chance' %}hidden{% endif %}">
            Indoor/Outdoor
            </div>  
          {% elsif lowercase_tags contains 'indoor' %}
            <div class="product-card__image-label body-xs {% if template.suffix == 'last-chance' %}hidden{% endif %}">
            Indoor
            </div>  
          {% elsif lowercase_tags contains 'outdoor' %}
            <div class="product-card__image-label body-xs {% if template.suffix == 'last-chance' %}hidden{% endif %}">
            Outdoor
            </div>  
          {% endif %}
        
      {% endunless %}

        {% if product_card_product.selected_or_first_available_variant.metafields.custom.last_chance_price.value != blank and product_card_product.price > product_card_product.selected_or_first_available_variant.metafields.custom.last_chance_price.value %}
          {% assign price_change = product_card_product.price | minus: product_card_product.selected_or_first_available_variant.metafields.custom.last_chance_price.value %}
          {% assign percent_discount = price_change | times: 100 | divided_by: product_card_product.price %}
        <div class="product-card__discount-flag">
          <div class="product-card__discount-amount">{{ percent_discount }} <span>%</span></div>
          <span>off</span>
        </div>
        {% endif %}
      </a>
    </div>
    {% if simple_card == true %}<div>{% endif %}

    {% if template.suffix == 'last-chance' %}
      {% comment %} <div class="product-card__type-label body-xs">
        {% if product_card_product.first_available_variant.metafields.custom.use != blank %}
          {{ product_card_product.first_available_variant.metafields.custom.use }}
        {% elsif lowercase_tags contains 'indoor' and lowercase_tags contains 'outdoor' %}
          Indoor/Outdoor
        {% elsif lowercase_tags contains 'indoor' %}
          Indoor
        {% elsif lowercase_tags contains 'outdoor' %}
          Outdoor
        {% endif %}
      </div> {% endcomment %}
      {% if lowercase_tags contains 'best seller' %}
        <div class="product-card__type-label body-xs">
          Best Seller
        </div>
      {% endif %}
    {% endif %}

    {% if section.settings.show_metafield_style %}
      {% if product_card_product.metafields.custom.product_card_style.value != blank %}
        <div class="product-card__metafield-style">
          {{ product_card_product.metafields.custom.product_card_style.value }}
        </div>
      {% endif %}
    {% endif %}
      
    {% if plp_layout %}
      <a href="{{ product_card_product.url }}" class="product-card__heading">
        <p class="product-card__line">{{ card_line }}</p>
        <p class="product-card__name">{{ card_name }}</p>
      </a>
    {% elsif title != blank or collection.title != blank %}
      <a href="{{ product_card_product.url }}">
        <div class="product-card__title blue">
          <span class="h3">{{ title | default: collection.title | remove: '3 x 5' | replace: ' | ', '<br>' }}</span>
          <span class="body">{{ product_card_product.options_by_name['color'].values[0] }}</span>
          {% comment %} {%- if collection.metafields.custom.dimensions != blank -%}
            <span class="body">({{ collection.metafields.custom.dimensions }})</span>
          {%- endif -%} {% endcomment %}
        </div>
      </a>
    {% endif %}


    {% if plp_layout != true or show_reviews %}
    <!-- Start of Judge.me code -->
    <div class='jdgm-widget jdgm-preview-badge xtreviewbadge' data-id='{{ product_card_product.id }}'>
    <a href="{{ product_card_product.url }}/#judgeme_product_reviews" aria-label="View product reviews">
      {% render 'judgeme-badge-no-schema', product: product_card_product %}
      </a>
    </div>
    <!-- End of Judge.me code -->
    {% endif %}

    {% assign enable_auto_discount_price = settings.enable_auto_discount_price %}
    {% assign auto_discount_price = product_card_product.metafields.custom.auto_discount_price %}
    {% assign show_discounted_price = false %}
    {% if enable_auto_discount_price and auto_discount_price > 0 %}
      {% assign show_discounted_price = true %}
      {% assign auto_discount_price = auto_discount_price | times: 100 |  money %}
    {% endif %}

    {% if customer and customer.b2b? %}
      <p class="product-card__price body blue" data-product-id="{{ product_card_product.id }}" data-variant-id="{{ product_card_product.selected_or_first_available_variant.id }}">
        {% assign trade_pricing_discount_percentage = settings.trade_pricing_discount_percentage | times: 1 %}
        {% assign discount_factor = 100 | minus: trade_pricing_discount_percentage %}
        {% assign original_price = product_card_product.price | times: 100 | divided_by: discount_factor %}

        {% if original_price > 0 %}
          <span class="sale-price">{{ product_card_product.price | money_without_trailing_zeros }}</span>
          <span class="old-price">{{ original_price | money_without_trailing_zeros }}</span>
        {% else %}
          <span>{{ product_card_product.price | money_without_trailing_zeros }}</span>
        {% endif %}        
      </p>
    {% else %}
      {% if show_discounted_price %}
        <p class="product-card__price body blue" data-product-id="{{ product_card_product.id }}" data-variant-id="{{ product_card_product.selected_or_first_available_variant.id }}">
          <span class="sale-price">{{ auto_discount_price }}</span>
          <span class="old-price">{{ product_card_product.price | money_without_trailing_zeros }}</span>
        </p>
      {% else %}
        <p class="product-card__price body blue" data-product-id="{{ product_card_product.id }}" data-variant-id="{{ product_card_product.selected_or_first_available_variant.id }}">
          {% if product_card_product.selected_or_first_available_variant.metafields.custom.last_chance_price.value != blank and product_card_product.price > product_card_product.selected_or_first_available_variant.metafields.custom.last_chance_price.value %}
            {% liquid
                assign sale_price = product_card_product.selected_or_first_available_variant.metafields.custom.last_chance_price.value | times: 1.0
              %}
              <span class="sale-price">{{ product_card_product.selected_or_first_available_variant.metafields.custom.last_chance_price.value | money_without_trailing_zeros }}</span>
              <span class="old-price">{{ product_card_product.price | money_without_trailing_zeros }}</span>
          {% else %}
            <span>{{ product_card_product.price | money_without_trailing_zeros }}</span>
          {% endif %}
        </p>
      {% endif %}
    {% endif %}
    
    {% comment %}
    <p class="product-card__price body blue">
      {% assign product_price = product_card_product.price %}
      {% assign last_chance_price = product_card_product.selected_or_first_available_variant.metafields.custom.last_chance_price.value %}
    
      {% if customer and customer.price_list %}
        {% assign b2b_price = product_card_product.selected_or_first_available_variant.price %} 
    
        {% if b2b_price < product_price %}
          <span class="old-price">{{ product_price | money_without_trailing_zeros }}</span>
          <span>{{ b2b_price | money_without_trailing_zeros }}</span>
        {% else %}
          <span>{{ product_price | money_without_trailing_zeros }}</span>
        {% endif %}
    
      {% elsif last_chance_price != blank and product_price > last_chance_price %}
        <span class="old-price">{{ product_price | money_without_trailing_zeros }}</span>
        <span>{{ last_chance_price | money_without_trailing_zeros }}</span>
      {% else %}
        <span>{{ product_price | money_without_trailing_zeros }}</span>
      {% endif %}
    </p>
    {% endcomment %}

    {% unless template.suffix == 'last-chance' %}
    <div class="product-card__swatches">
      {% if active_swatch != blank %}
        <a href="{{ active_swatch_link | default: active_swatch.variants[0].url }}" data-tooltip="{{ active_swatch_tooltip_value }}" aria-label="{{ active_swatch_tooltip_value }}" class="product-card__swatch" style="background-image: url({{ active_swatch_file_name | file_img_url: '60x60' }})"></a>
      {% endif %}
      {{ color_swatch_list }}
      {% if plp_layout and card_color_count > 0 %}
        <span class="product-card__color-count">{{ card_color_count }} color{% if card_color_count != 1 %}s{% endif %}</span>
      {% endif %}
    </div>
    {% endunless %}

    {% if collection.metafields.custom.short_description != blank %}
      {% unless simple_card == true %}
        <div class="product-card__description body" {% unless template.suffix == "last-chance" %}style="display: none;{% endunless %}">
          {{ collection.metafields.custom.short_description }}

          {%- if collection.metafields.custom.dimensions != blank and template.suffix == 'last-chance' -%}
            <div class="body product-card__dimensions">({{ collection.metafields.custom.dimensions }})</div>
          {%- endif -%}
        </div>
      {% endunless %}
    {% endif %}

    {% if template.suffix == 'last-chance' %}
      <div>
        {% comment %}<div class="product-card__urgency">Only {{ product_card_product.selected_or_first_available_variant.inventory_quantity }} products left!</div>{% endcomment %}
      {% assign isSoldOut = false %}
      {% unless product_card_product.selected_or_first_available_variant.available and product_card_product.selected_or_first_available_variant.inventory_policy != 'continue' %}
        {% assign isSoldOut = true %}
      {% endunless %}
        
      <button {% unless isSoldOut %}data-quick-add{% endunless %} class="product-card__quick-add button" data-variant="{{ product_card_product.selected_or_first_available_variant.id }}" {% if isSoldOut %}disabled="disabled"{% endif %}>
        {% if isSoldOut %}
          <span>Sold Out</span>
        {% else %}
          <span>Add to Cart</span>
        {% endif %}
        <div class="loading-overlay__spinner">
          <svg
            aria-hidden="true"
            focusable="false"
            role="presentation"
            class="spinner"
            viewBox="0 0 66 66"
            xmlns="http://www.w3.org/2000/svg"
          >
            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
          </svg>
        </div>
      </button>
      </div>
    {% else %}
      <a href="{{ product_card_product.url }}" class="text-link-2 gold-secondary--dark product-card__link">
      {{- button_text }} <span class="btn-arrow"> > </span> </a>
    {% endif %}
  {% if simple_card == true %}</div>{% endif %}
  </div>
</grouped-product-card>