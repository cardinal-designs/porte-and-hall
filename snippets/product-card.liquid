{% comment %}
  Renders a product card

  Accepts:
  - product_card_product: {Object} Product Liquid object

  Usage:
  {% render 'product-card', product_card_product: product %}
{% endcomment %}

<div class="product-card{% if product_card_product.media[1] != nil %} has-animation{% endif %}">
  <a href="{{ product_card_product.url | split: '?' | first }}">
    <div class="product-card__image">
      {% render 'lazy-image', image: product_card_product.featured_media, fade: false, classes: 'img-fill', aria-label: "Product image", eager: prioritize_loading, widthI: 800, sizes: '(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 45vw', widths: '200, 360, 535, 750, 800' %}
      {% if product_card_product.media[1] != null %}
        {% render 'deferred-hover-image', image: product_card_product.media[1], classes: 'img-fill', sizes: '(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 45vw' %}
      {% endif %}

      {% assign lowercase_tags = product_card_product.tags | join: '~~~' | downcase | split: '~~~' %}
      
        {% if lowercase_tags contains 'indoor' and lowercase_tags contains 'outdoor' %}
          <div class="product-card__image-label body-xs">
          Indoor/Outdoor
          </div>
        {% elsif lowercase_tags contains 'indoor' %}
          <div class="product-card__image-label body-xs">
          Indoor
          </div>
        {% elsif lowercase_tags contains 'outdoor' %}
          <div class="product-card__image-label body-xs">
          Outdoor
          </div>
        {% endif %}
      
    </div>
  </a>
  <div class="product-card__container">
    <p class="product-card__title">{{ product_card_product.title }}</p>
    <div class="product-card__content">

      {% assign card_variant = product_card_product.selected_or_first_available_variant %}
      {% assign show_compare_at_sale = false %}
      {% if settings.show_compare_at_price and card_variant.compare_at_price != blank and card_variant.compare_at_price > card_variant.price %}
        {% assign show_compare_at_sale = true %}
      {% endif %}

      {% if customer and customer.b2b? %}
        {% assign trade_pricing_discount_percentage = settings.trade_pricing_discount_percentage | times: 1 %}
        {% assign discount_factor = 100 | minus: trade_pricing_discount_percentage %}
        {% assign original_price = product_card_product.price | times: 100 | divided_by: discount_factor %}

        <p class="product-card__price">
          {% if original_price > 0 %}
            <span class="old-price">{{ original_price | money_without_trailing_zeros }}</span>
          {% endif %}
          {{ product_card_product.price | money_without_trailing_zeros }}
        </p>
      {% else %}
        <p class="product-card__price">
          {{ card_variant.price | money_without_trailing_zeros }}
          {% if show_compare_at_sale %}
            <span class="old-price">{{ card_variant.compare_at_price | money_without_trailing_zeros }}</span>
          {% endif %}
        </p>
      {% endif %}
    </div>
  </div>
</div>
