{%- liquid
  assign swatch_handle = value.label | remove: '(' | remove: ')' | handle
  assign swatch_hex = ''
  assign swatch_url = ''

  # Hex / image per colour lives in snippets/color-swatch-map.liquid (also used by the search page).
  capture swatch_map
    render 'color-swatch-map'
  endcapture
  assign swatch_entries = swatch_map | strip | split: '|'
  for swatch_entry in swatch_entries
    assign swatch_pair = swatch_entry | split: '~'
    if swatch_pair[0] == swatch_handle
      assign swatch_value = swatch_pair[1]
      assign swatch_first_char = swatch_value | slice: 0
      if swatch_first_char == '#'
        assign swatch_hex = swatch_value
      else
        assign swatch_url = swatch_value
      endif
      break
    endif
  endfor

  if swatch_hex == blank and swatch_url == blank
    assign swatch_file = swatch_handle | append: '.png'
    if images[swatch_file] != blank
      assign swatch_url = swatch_file | file_img_url: '60x60'
    endif
  endif

  assign swatch_classes = 'collection-filters__filter-swatch swatch-color--' | append: swatch_handle
  if swatch_hex == blank and swatch_url == blank
    assign swatch_classes = swatch_classes | append: ' collection-filters__filter-swatch--unmapped'
  endif
-%}

<span
  class="{{ swatch_classes }}"
  {% if swatch_hex != blank %}
    style="background-color: {{ swatch_hex }};"
  {% elsif swatch_url != blank %}
    style="background-image: url('{{ swatch_url }}');"
  {% endif %}
></span>
