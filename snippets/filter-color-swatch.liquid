{%- liquid
  assign swatch_handle = value.label | remove: '(' | remove: ')' | handle
  assign swatch_hex = ''
  assign swatch_url = ''

  case swatch_handle
    when 'blue'
      assign swatch_hex = '#2C45B9'
    when 'grey', 'gray'
      assign swatch_hex = '#D9D9D9'
    when 'brown'
      assign swatch_hex = '#8A6F6E'
    when 'beige', 'off-white', 'offwhite', 'cream', 'ivory'
      assign swatch_hex = '#F6F0E8'
    when 'green'
      assign swatch_hex = '#447924'
    when 'red'
      assign swatch_hex = '#EB514A'
    when 'orange'
      assign swatch_hex = '#F4B43F'
    when 'pink'
      assign swatch_hex = '#F6C3CB'
    # 'multi' reuses the colour-wheel asset the base.css mapping already points at
    when 'multi', 'multicolor', 'multicolour'
      assign swatch_url = 'https://cdn.shopify.com/s/files/1/0084/8602/7327/files/color-wheel_1.png?v=1694583299'
  endcase

  if swatch_hex == blank and swatch_url == blank
    assign swatch_file = swatch_handle | append: '.png'
    if images[swatch_file] != blank
      assign swatch_url = swatch_file | file_img_url: '60x60'
    endif
  endif

  assign swatch_classes = 'collection-filters__filter-swatch swatch-color--' | append: swatch_handle
  if swatch_hex == blank and swatch_url == blank
    assign swatch_classes = swatch_classes | append: ' collection-filters__filter-swatch--unmapped'
  endif
-%}

<span
  class="{{ swatch_classes }}"
  {% if swatch_hex != blank %}
    style="background-color: {{ swatch_hex }};"
  {% elsif swatch_url != blank %}
    style="background-image: url('{{ swatch_url }}');"
  {% endif %}
></span>
