{% doc %}
  Renders product media for the gallery and thumbnails.

  @param {object} media - Product Media object
  @param {number} [position] - Position of the media (1 = LCP candidate)
  @param {string} [width] - Thumbnail width override (e.g. "106")
  @param {boolean} [loop] - Enable video looping (optional)
  @param {string} [modal_id] - Product modal id
  @param {boolean} [xr_button] - Render XR button for 3D models

  @example
  {% render 'product-media', media: media, position: forloop.index %}
  {% render 'product-media', media: media, position: forloop.index, width: '106' %}
{% enddoc %}

{%- liquid
  assign is_thumbnail = false
  if width != blank
    assign is_thumbnail = true
    assign thumb_width = width | plus: 0
    assign thumb_2x = thumb_width | times: 2
  endif

  assign is_lcp = false
  if position == 1 or position == '1'
    assign is_lcp = true
  endif
-%}

<noscript>
  {% if media.media_type == 'video' or media.media_type == 'external_video' %}
    <span class="product__media-icon motion-reduce">{% render 'icon', icon: 'play' %}</span>
    <div
      class="product__media media"
      style="padding-top: {{ 1 | divided_by: media.preview_image.aspect_ratio | times: 100 }}%;"
    >
      {{
        media.preview_image
        | image_url: width: 1100
        | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 769px) 50vw, 100vw',
          widths: '288, 576, 750, 1100, 1500',
          alt: media.preview_image.alt
      }}
    </div>
    <a
      href="{% if media.media_type == 'video' %}{{ media.sources[1].url }}{% else %}{{ media | external_video_url }}{% endif %}"
      class="product__media-toggle"
    >
      <span class="visually-hidden">
        {{- 'products.product.video_exit_message' | t: title: product.title | escape -}}
      </span>
    </a>
  {% else %}
    <div
      class="product__media media"
      style="padding-top: {{ 1 | divided_by: media.preview_image.aspect_ratio | times: 100 }}%;"
    >
      {{
        media.preview_image
        | image_url: width: 1100
        | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 769px) 50vw, 100vw',
          widths: '288, 576, 750, 1100, 1500',
          alt: media.preview_image.alt
      }}
    </div>
  {% endif %}
</noscript>

<div class="product__media">
  {% if media.media_type == 'image' %}
    {% if is_thumbnail %}
      {% capture thumb_widths %}{{ thumb_width }}, {{ thumb_2x }}{% endcapture %}
      {% assign thumb_sizes = thumb_width | append: 'px' %}
      {% render 'lazy-image',
        image: media.preview_image,
        fade: true,
        classes: 'img-fill',
        widthI: thumb_2x,
        sizes: thumb_sizes,
        widths: thumb_widths
      %}
    {% else %}
      {% render 'lazy-image',
        image: media.preview_image,
        fade: true,
        classes: 'img-fill',
        widthI: 1200,
        sizes: '(min-width: 769px) 45vw, 100vw',
        widths: '360, 535, 750, 900, 1100, 1200, 1500',
        prioritize_loading: is_lcp
      %}
    {% endif %}
  {% elsif media.media_type == 'video' %}
    <video autoplay loop muted playsinline class="img-fill" {% unless is_lcp %}preload="none"{% endunless %}>
      <source src="{{ media.sources[1].url }}" type="video/mp4">
      Your browser does not support the video tag.
    </video>
  {% endif %}
</div>
