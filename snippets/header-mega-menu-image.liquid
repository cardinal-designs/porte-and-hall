{% comment %}
  Renders one image of a header mega menu panel.

  Accepts:
  - layout: {String} 'featured' (overlay tile) or 'grid' (card with caption below the image)
  - image_count: {Number} number of images rendered in the panel, used for the grid image sizes
  - image: {Object} image_picker value (required; only render this snippet for slots with an image)
  - badge: {String} optional badge shown on top of the image
  - subtitle: {String} optional kicker above the title
  - title: {String} optional title
  - text: {String} optional description
  - link_label: {String} optional call to action label
  - link: {String} optional link, makes the whole image clickable

  Usage:
  {% render 'header-mega-menu-image', layout: 'grid', image: block.settings.image_1, ... %}
{% endcomment %}

{%- liquid
  assign image_alt = image.alt | default: title | default: subtitle

  if layout == 'grid'
    assign columns = image_count | default: 1 | at_least: 1
    assign column_px = 1240 | divided_by: columns
    assign column_vw = 100 | divided_by: columns
    assign item_class = 'header__mega-menu-card'
    assign image_widths = '240, 360, 480, 720, 960, 1280'
    assign image_sizes = '(min-width: 1300px) ' | append: column_px | append: 'px, ' | append: column_vw | append: 'vw'
  else
    assign item_class = 'header__mega-menu-block'
    assign image_widths = '360, 480, 640, 800, 960'
    assign image_sizes = '(min-width: 1200px) 450px, 35vw'
  endif

  if link != blank
    assign tag = 'a'
  else
    assign tag = 'div'
  endif
-%}

<li class="{{ item_class }}-item">
  <{{ tag }}
    class="{{ item_class }}"
    {% if link != blank %}
      href="{{ link }}"
    {% endif %}
  >
    <div class="{{ item_class }}-media">
      {{
        image
        | image_url: width: 1280
        | image_tag:
          loading: 'lazy',
          widths: image_widths,
          sizes: image_sizes,
          class: 'header__mega-menu-block-image',
          alt: image_alt
      }}
      {% if badge != blank %}
        <span class="header__mega-menu-block-badge">{{ badge | escape }}</span>
      {% endif %}
    </div>

    <div class="header__mega-menu-block-content">
      {% if subtitle != blank %}
        <p class="header__mega-menu-block-subtitle">{{ subtitle | escape }}</p>
      {% endif %}
      {% if title != blank %}
        <p class="header__mega-menu-block-title">{{ title | escape }}</p>
      {% endif %}
      {% if text != blank %}
        <p class="header__mega-menu-block-text">{{ text | escape }}</p>
      {% endif %}
      {% if link_label != blank %}
        <span class="header__mega-menu-block-link">{{ link_label | escape }}</span>
      {% endif %}
    </div>
  </{{ tag }}>
</li>
