{%- comment -%}
  Below-the-fold video + text.
  Uses the same single-video + matchMedia pattern as video-text.liquid.
  Click-to-play UX preserved; MP4 bytes deferred until near viewport.
{%- endcomment -%}

{%- liquid
  assign desktop_video = section.settings.video
  assign mobile_video = section.settings.mobile_video
  assign has_mobile_video = false
  if desktop_video != blank and mobile_video != blank and mobile_video.id != desktop_video.id
    assign has_mobile_video = true
  endif

  if has_mobile_video and mobile_video.preview_image != blank
    assign poster_mobile_image = mobile_video.preview_image
  elsif desktop_video.preview_image != blank
    assign poster_mobile_image = desktop_video.preview_image
  endif

  if desktop_video.preview_image != blank
    assign poster_desktop_image = desktop_video.preview_image
  else
    assign poster_desktop_image = poster_mobile_image
  endif

  if poster_mobile_image != blank
    assign poster_url_mobile = poster_mobile_image | image_url: width: 750
  endif
  if poster_desktop_image != blank
    assign poster_url_desktop = poster_desktop_image | image_url: width: 1000
  endif

  assign captions_url = 'hero-captions-en.vtt' | file_url
-%}

{{ 'section-hero.css' | asset_url | stylesheet_tag }}
{% render 'ph-responsive-video' %}

<div class="hero video-with-text" id="VideoWithText-{{ section.id }}" data-section-type="video-with-text">
  <div class="hero__content">
    <div class="hero__container">
      <h3 class="hero__title">{{ section.settings.title }}</h3>
      <p>{{ section.settings.sub-text }}</p>
      <div class="content-section">
        {{ section.settings.content }}
      </div>
    </div>
  </div>

  <div class="hero__media">
    {%- if desktop_video != blank -%}
      {%- liquid
        # Prefer progressive MP4 only (matches Shopify video_tag loop behaviour;
        # avoids injecting HLS m3u8 that can create extra probes). Fall back to
        # all sources if no mp4 entry exists.
        capture sources_desktop_json
          echo '['
          assign mp4_count = 0
          for source in desktop_video.sources
            if source.mime_type == 'video/mp4'
              if mp4_count > 0
                echo ','
              endif
              echo '{"src":'
              echo source.url | json
              echo ',"type":'
              echo source.mime_type | json
              echo '}'
              assign mp4_count = mp4_count | plus: 1
            endif
          endfor
          if mp4_count == 0
            for source in desktop_video.sources
              echo '{"src":'
              echo source.url | json
              echo ',"type":'
              echo source.mime_type | json
              echo '}'
              unless forloop.last
                echo ','
              endunless
            endfor
          endif
          echo ']'
        endcapture

        if has_mobile_video
          capture sources_mobile_json
            echo '['
            assign mp4_count = 0
            for source in mobile_video.sources
              if source.mime_type == 'video/mp4'
                if mp4_count > 0
                  echo ','
                endif
                echo '{"src":'
                echo source.url | json
                echo ',"type":'
                echo source.mime_type | json
                echo '}'
                assign mp4_count = mp4_count | plus: 1
              endif
            endfor
            if mp4_count == 0
              for source in mobile_video.sources
                echo '{"src":'
                echo source.url | json
                echo ',"type":'
                echo source.mime_type | json
                echo '}'
                unless forloop.last
                  echo ','
                endunless
              endfor
            endif
            echo ']'
          endcapture
        endif
      -%}

      <video
        data-deferred-video
        id="video-with-text-{{ section.id }}"
        class="videos"
        playsinline
        muted
        preload="none"
        data-poster-mobile="{{ poster_url_mobile | default: poster_url_desktop | escape }}"
        data-poster-desktop="{{ poster_url_desktop | default: poster_url_mobile | escape }}"
        data-sources-desktop="{{ sources_desktop_json | strip_newlines | escape }}"
        {% if has_mobile_video %}
          data-sources-mobile="{{ sources_mobile_json | strip_newlines | escape }}"
        {% endif %}
        {% if poster_url_desktop != blank or poster_url_mobile != blank %}
          poster="{{ poster_url_desktop | default: poster_url_mobile }}"
        {% endif %}
        aria-label="{{ section.settings.title | default: 'Video' | escape }}"
      >
        <track kind="captions" src="{{ captions_url }}" srclang="en" label="English" default>
      </video>

      <button
        type="button"
        id="circle-play-{{ section.id }}"
        class="hero__element"
        aria-label="Play or pause video"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="45" height="50" viewBox="0 0 45 50" fill="none" aria-hidden="true">
          <path d="M42.9214 21.5359C45.5881 23.0755 45.5881 26.9245 42.9214 28.4641L6.92138 49.2487C4.25472 50.7883 0.921387 48.8638 0.921387 45.7846L0.921387 4.21539C0.921387 1.13619 4.25472 -0.788311 6.92139 0.751289L42.9214 21.5359Z" fill="white"/>
        </svg>
      </button>
    {%- endif -%}
  </div>
</div>

<script>
(function () {
  var rootId = 'VideoWithText-{{ section.id }}';

  window.PHInitVideoWithText = function (root) {
    if (!root || root.getAttribute('data-video-init') === 'true') return;
    if (!window.PHResponsiveVideo) return;

    var video = root.querySelector('video[data-deferred-video]');
    var playBtn = root.querySelector('.hero__element');
    if (!video || !playBtn) return;

    root.setAttribute('data-video-init', 'true');
    // Listen for mobile↔desktop crossings only after init; switch is no-op until sources applied.
    window.PHResponsiveVideo.bindBreakpointSwitch(video);

    function ensureSources() {
      var result = window.PHResponsiveVideo.applyViewportSource(video);
      if (!result || !result.ok) return false;
      if (result.changed) {
        try {
          video.load();
        } catch (e) {}
      }
      return true;
    }

    // Prefetch the correct viewport source when section nears viewport (not on page load).
    window.PHResponsiveVideo.whenNear(
      root,
      function () {
        ensureSources();
      },
      300
    );

    function togglePlay() {
      if (!ensureSources()) return;

      function run() {
        if (video.paused || video.ended) {
          var p = video.play();
          if (p && typeof p.catch === 'function') p.catch(function () {});
        } else {
          video.pause();
        }
      }

      if (video.readyState >= 2) {
        run();
      } else {
        video.addEventListener('loadeddata', run, { once: true });
      }
    }

    playBtn.addEventListener('click', togglePlay);
    video.addEventListener('playing', function () {
      playBtn.style.opacity = 0;
    });
    video.addEventListener('pause', function () {
      playBtn.style.opacity = 1;
    });
  };

  function boot() {
    window.PHInitVideoWithText(document.getElementById(rootId));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

  if (!window.__phVwtSectionLoadBound) {
    window.__phVwtSectionLoadBound = true;
    document.addEventListener('shopify:section:load', function (event) {
      var sectionEl = event.target;
      if (!sectionEl || !window.PHInitVideoWithText) return;
      var root = sectionEl.querySelector('[data-section-type="video-with-text"]');
      if (!root) return;
      root.removeAttribute('data-video-init');
      var video = root.querySelector('video[data-deferred-video]');
      if (video) {
        if (window.PHResponsiveVideo && window.PHResponsiveVideo.unbindBreakpointSwitch) {
          window.PHResponsiveVideo.unbindBreakpointSwitch(video);
        }
        video.removeAttribute('data-sources-applied');
        video.removeAttribute('data-source-mode');
        video.removeAttribute('data-current-src');
      }
      window.PHInitVideoWithText(root);
    });
  }

  // Remove MediaQueryList listener while the old video is still in the DOM.
  // section:load alone cannot reach the detached previous element.
  if (!window.__phVwtSectionUnloadBound) {
    window.__phVwtSectionUnloadBound = true;
    document.addEventListener('shopify:section:unload', function (event) {
      var sectionEl = event.target;
      if (!sectionEl || !window.PHResponsiveVideo) return;
      var video = sectionEl.querySelector('video[data-deferred-video]');
      if (video && window.PHResponsiveVideo.unbindBreakpointSwitch) {
        window.PHResponsiveVideo.unbindBreakpointSwitch(video);
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "Video with text",
  "class": "video-text",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (default media if populated)"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile Video"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "sub-text",
      "label": "Content"
    },
    {
      "type": "textarea",
      "id": "content",
      "label": "List Section"
    }
  ],
  "presets": [
    {
      "name": "Video with text"
    }
  ]
}
{% endschema %}

<style>
  .video-with-text .hero__element{
    right: 50%;
    bottom: 50%;
    transform: translate(50%, 50%);
    width: auto;
    cursor: pointer;
    border: none;
    background: transparent;
    padding: 0;
  }

  .video-text .hero__content .hero__container .hero__title{
    font-size: 48px;
    font-style: normal;
    font-weight: 500;
    line-height: 62px; /* 110.714% */
    letter-spacing: 1.12px;
    font-family: louize;
    position:relative;
    text-transform:none;
  }

  .video-text .hero__content .hero__container .hero__title:before{
    content: '';
    background: white;
    position:absolute;
    width: 159px;
    height: 4px;
    bottom: -9px;
  }

   .video-text .hero__content .hero__container p{
       font-family: brandon;
      font-size: 20px;
      font-style: normal;
      font-weight: 400;
      line-height: 28px; /* 140% */
      max-width:400px;
   }

  .video-text .hero__content .hero__container .content-section li{
      position:relative;
      font-family: brandon;
      font-size: 16px;
      font-style: normal;
      font-weight: 400;
      line-height: 18px; /* 175% */
      margin-bottom:10px;
  }
  .video-text .hero__container{
     border:none !important;
  }
  .video-text .hero__content .hero__container .content-section li::marker{
     display:none !important;
     color:#546B82;
  }

   .video-text .hero__content .hero__container .content-section li:before{
       content:'';
       position:absolute;
       width: 9px;
       height:9px;
       background:transparent;
       left: -19px;
       border: 1.5px solid white;
       transform: rotate(-45deg);
       bottom: 5px;
   }

   .video-text .hero__content .hero__container .content-section{
      margin-left: -15px;
   }
  .hero.video-with-text{
    background: var(--blue);
    min-height: 450px;
  }
  .hero.video-with-text .hero__content{
    padding:0px;
  }

  @media screen and (min-width: 769px){
    .hero.video-with-text{
      grid-template-columns:1.3fr 1fr;
      padding: 0 20px 0px;
      margin-top: 40px;
      min-height: 350px;
    }
    .hero.video-with-text .hero__container{
      padding: 20px 20px 20px 0;
      max-width: 100%;
    }
    .hero.video-with-text .hero__media{
      top:-40px;
    }
    .hero.video-with-text .hero__media{
      aspect-ratio: 16/9;
      width: 100%;
      height: 100%;
    }
  }
  
  @media screen and (min-width: 1200px){
    .hero.video-with-text{
      grid-template-columns:1.3fr 1fr;
      padding: 0 80px 0px;
      margin-top: 40px;
      min-height: 450px;
    }
    .hero.video-with-text .hero__container{
      padding: 60px;
      max-width: 85%;
    }
    .hero.video-with-text .hero__media{
      top:-40px;
    }
  }

  @media screen and (max-width: 768px){
    .video-text .hero__container{
      padding:0px 20px 20px;
      margin-top:-20px;
    }
    .hero.video-with-text .hero__media{
      top:-40px;
      padding:0 20px;
    }
  }

    @media screen and (max-width: 640px) {
      .video-text .hero__content .hero__container .hero__title{
        font-size: 32px;
        font-weight: 500;
        line-height: 40px;
        letter-spacing: 0.64px;
      }
     .video-text .hero__content .hero__container p, .video-text .hero__content .hero__container .content-section li {
        font-size: 14px;
      font-weight: 400;
      line-height: 18px;
       margin-top:12px;
      }
      .video-text .hero__content .hero__container .hero__title:before{
         width: 90px;
      }
      .video-text .hero__content .hero__container .content-section li:before{
         bottom: 5px;
      }
    }
</style>
