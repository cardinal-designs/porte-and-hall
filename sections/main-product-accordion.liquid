{% comment %}theme-check-disable TemplateLength{% endcomment %}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{%- if section.settings.show_delivery_estimate -%}
  <script src="{{ 'pdp-delivery-estimate.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{% style %}
  {%- if section.settings.background_color != blank -%}
    #shopify-section-{{ section.id }} {
      background: {{ section.settings.background_color }};
    }
  {%- endif -%}

  square-placement {
    margin-bottom: 0 !important;
    margin-top: 10px !important;
  }

  @media (max-width: 768px) {
    square-placement {
      text-align: center !important;
    }
  }
{% endstyle %}

{% assign size_position = product.options_with_values | find_index: "name", "Size" | plus: 1 %}
{% assign option_name = "option" | append: size_position %}
{% assign size_value = product.selected_or_first_available_variant[option_name]  %}

{% liquid
  for collection in product.collections
    if collection.title contains ' |'
      assign grouped_collection = collection
    endif
  endfor
  
  assign oos_products = grouped_collection.products | where: 'available', false
  assign oos_products = ""

  assign color_label = 'color,colour,couleur,colore,farbe,색,色,färg,farve' | split: ','
  assign collection_title = grouped_collection.title | downcase

  # Preorder: the same condition the Add to cart label uses. A range counted from
  # today would be wrong for stock that hasn't arrived, so the estimate is skipped.
  assign is_preorder = false
  if product.selected_or_first_available_variant.inventory_policy == 'continue' and product.selected_or_first_available_variant.inventory_quantity <= 0
    assign is_preorder = true
  endif

  # Accordion content lives on the product's collection — the one
  # product.metafields.custom.collection_for_metafield_content points at, which the
  # theme editor connects to section.settings.collection. The grouped collection is
  # the fallback, as elsewhere in this section.
  assign content_collection = grouped_collection
  if section.settings.collection != blank
    assign content_collection = section.settings.collection
  endif
  assign shipping_returns_metafield = content_collection.metafields.custom.shipping_returns
  # custom.faqs is a list of FAQ metaobjects (fields: question, answer), the same
  # source the `faq` section repeats over. Not rich text — don't metafield_tag it.
  assign faqs_metaobjects = content_collection.metafields.custom.faqs.value

  # % off badge over the gallery. Same discount sources the price block renders,
  # in the same order, so the badge can never disagree with the price.
  assign badge_variant = product.selected_or_first_available_variant
  assign badge_last_chance_price = badge_variant.metafields.custom.last_chance_price.value
  assign badge_auto_discount_price = product.metafields.custom.auto_discount_price
  assign pdp_percent_off = 0
  if customer and customer.b2b?
    assign pdp_percent_off = 0
  elsif badge_last_chance_price != blank and product.price > badge_last_chance_price
    assign pdp_percent_off = product.price | minus: badge_last_chance_price | times: 100.0 | divided_by: product.price | round
  elsif settings.enable_auto_discount_price and badge_auto_discount_price > 0
    assign badge_auto_discount_cents = badge_auto_discount_price | times: 100
    if badge_variant.price > badge_auto_discount_cents
      assign pdp_percent_off = badge_variant.price | minus: badge_auto_discount_cents | times: 100.0 | divided_by: badge_variant.price | round
    endif
  elsif badge_variant.compare_at_price > badge_variant.price
    assign pdp_percent_off = badge_variant.compare_at_price | minus: badge_variant.price | times: 100.0 | divided_by: badge_variant.compare_at_price | round
  endif

  # Colour line, e.g. "The Insider | Doormat" -> "Insider", for the reveal link.
  assign product_line_name = grouped_collection.title | split: ' | ' | first | strip | remove_first: 'The ' | strip
  assign visible_swatch_limit = 5
  assign hidden_swatch_count = 0

  # Where the selected colour sits, and how many colours there are. Counted
  # exactly like the render loop below, so the two always agree.
  assign active_swatch_position = 0
  assign swatch_total = 0
  assign swatch_position = 0
  for swatch in grouped_collection.products
    for option in swatch.options_with_values
      assign option_name = option.name | downcase
      if color_label contains option_name or option_name == 'style'
        for value in option.values
          assign swatch_position = swatch_position | plus: 1
          assign swatch_total = swatch_total | plus: 1
          if swatch == product and option.selected_value == value
            assign active_swatch_position = swatch_position
          endif
        endfor
      endif
    endfor
  endfor

  # Collapsed state: the selected colour first, then the next colours in list
  # order until five are showing. With five or fewer colours nothing is hidden.
  assign other_swatch_limit = visible_swatch_limit
  if active_swatch_position > 0
    assign other_swatch_limit = visible_swatch_limit | minus: 1
  endif
  assign shown_other_swatches = 0

  capture color_swatch_list
  assign swatch_count = 1
  for swatch in grouped_collection.products

    
    assign show_badge = false
    for tag in swatch.tags
      assign tag_lower = tag | downcase
      if tag_lower == 'new'
        assign show_badge = true
      endif
    endfor

    for option in swatch.options_with_values
      assign option_name = option.name | downcase
      if color_label contains option_name or option_name == 'style'
        assign option_index = 'option' | append: forloop.index
        for value in option.values
          assign matched_variant = swatch.variants | where: 'title', value
          if matched_variant != blank
            assign swatch_link = matched_variant[0].url
          endif

          assign element_classes = 'product__swatch'
          if swatch == product and option.selected_value == value
            assign element_classes = element_classes | append: ' product__active-swatch '
          endif
          # The selected colour always shows; the others fill the remaining slots
          # in list order. CSS moves the selected one to the front while collapsed.
          if swatch_total > visible_swatch_limit and swatch_count != active_swatch_position
            if shown_other_swatches < other_swatch_limit
              assign shown_other_swatches = shown_other_swatches | plus: 1
            else
              assign element_classes = element_classes | append: ' product__swatch--extra hidden'
              assign hidden_swatch_count = hidden_swatch_count | plus: 1
            endif
          endif
          if swatch.available == false
            assign element_classes = element_classes | append: ' product__oos-swatch'
          endif
          if show_badge
            assign element_classes = element_classes | append: ' product__new-swatch'
          endif

          assign swatch_file_name = value | handle | append: '.png'
          assign swatch_image = images[swatch_file_name]

          echo "<product-swatch data-href='"
          echo swatch_link | default: swatch.variants[0].url
          echo "' class='"
          echo element_classes
          echo "'"
          echo " aria-label='"
          echo value | escape
          unless swatch.available
            echo " is Unavailable"
          endunless
          echo "'"
          echo " data-tooltip='"
          echo value | escape
          echo "'>"

          if show_badge
            echo '<span class="product__swatch-badge-new"><svg class="swatch-ring-svg" width="72" height="69" viewBox="0 0 72 69"><path d="M 50.14 4.62 A 34.48 34.48 0 1 1 22.10 4.62" fill="none" stroke="#546B82" stroke-width="1.1"></path><path id="ringTextPathDesktop" d="M 23.20 4.15 A 34.48 34.48 0 0 1 49.04 4.15" fill="none" stroke="none"></path><text font-family="Brandon Grotesque, sans-serif" font-size="10" font-weight="700" letter-spacing="0.4" fill="#546B82"><textPath href="#ringTextPathDesktop" startOffset="50%" text-anchor="middle">NEW!</textPath></text></svg></span>'
          endif

          echo "<span style='background-image: url("
          echo swatch_file_name | file_url
          echo ")'></span>"

          echo '</product-swatch>'

          assign swatch_count = swatch_count | plus: 1
        endfor
      endif
    endfor
  endfor
endcapture
%}

  {% comment %} <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script> {% endcomment %}

<div>
  <product-section data-section="{{ section.id }}" data-product="{{ product.title }}">
    <section class="page-width main-product-accordion">
      <div class="product">
        <a class="skip-to-content-link button visually-hidden" href="#ProductInfo-{{ section.id }}">
          {{ 'accessibility.skip_to_product_info' | t }}
        </a>

        <div class="product__media-wrapper">
          <div class="hide-mobile product__media-thumbnails list-unstyled swiper">
            <div class="swiper-wrapper">
              {% for media in product.media %}
                {% unless media.alt == 'hide-outlier' %}
                <div class="product__media-thumbnail-item swiper-slide" data-media-id="{{ section.id }}-{{ media.id }}">
                  {% render 'product-media', media: media, position: forloop.index, width: '106' %}
                </div>
              {% endunless %}
              {% endfor %}
            </div>
          </div>

          <div class="product__media-list list-unstyled swiper">
            {%- comment -%}
              Same flag markup as the product card, so PDP and PLP read alike.
              It lives in the image area, not the media wrapper, which also holds
              the thumbnail column.
            {%- endcomment -%}
            {%- if pdp_percent_off > 0 -%}
              <div class="product-card__discount-flag product__discount-flag">
                <div class="product-card__discount-amount">{{ pdp_percent_off }} <span>%</span></div>
                <span>off</span>
              </div>
            {%- endif -%}
            <div class="swiper-wrapper">
              {% for media in product.media %}
                {% unless media.alt == 'hide-outlier' %}
                <div class="product__media-item swiper-slide" data-media-id="{{ section.id }}-{{ media.id }}">
                  {% render 'product-media', media: media, position: forloop.index %}
                  <div class="product__media-buttons">
                    {% unless section.settings.hide_pinterest == true %}
                      {% render 'pin-button', media: media %}
                    {% endunless %}
                    {% render 'zoom-button' %}
                  </div>
                </div>
                {% endunless %}
              {% endfor %}
            </div>
            <div class="product__media-pagination swiper-pagination hide-desktop"></div>
            <div class="product__media-button swiper-button-prev hide-desktop"></div>
            <div class="product__media-button swiper-button-next hide-desktop"></div>
          </div>
        </div>

        <div class="product__info-wrapper">
          <div id="ProductInfo-{{ section.id }}" class="product__info-container">
            {% assign product_form_id = 'product-form-' | append: section.id %}

            <h3 class="product__tag gold--dark">
              {{ product.variants.first.metafields.filters.use.value.first }}
            </h3>

            <h1 class="product__title blue">
              {% if product.title contains 'Porter' %}
                The Porter Mat
              {% elsif grouped_collection.title contains '5 x 7 Area Mat' %}
                The Innerweave Area Mat
              {% elsif grouped_collection.title contains '3 x 5' %}
              {{ grouped_collection.title | remove: ' |' | remove: '3 x 5' | default: product.title }}
              {% elsif product.title contains 'Everymat' %}
                The Everymat
              {% else %}
              {{ grouped_collection.title | remove: ' |' | default: product.title }}
              {% endif %}
            </h1>

            {% unless product.tags contains 'Swatch' %}
              <div class="afaf product__price-reviews-wrapper{% if customer and customer.b2b? %} product__price-reviews-wrapper--trade{% endif %}">
                <div class="no-js-hidden product__price" id="price-{{ section.id }}" role="status">
                  {% if customer and customer.b2b? %}
                    {% liquid
                      assign sale_price = product.selected_or_first_available_variant.metafields.custom.last_chance_price.value | times: 1.0
                      assign percent_off = product.price | minus: sale_price | times: 100.0 | divided_by: product.price | round 

                      assign target = product.selected_or_first_available_variant
                      assign price = target.price
                      assign money_price = price | money_without_trailing_zeros
                      if settings.currency_code_enabled
                        assign money_price = price | money_with_currency
                      endif

                      assign trade_pricing_discount_percentage = settings.trade_pricing_discount_percentage | times: 1
                      assign discount_factor = 100 | minus: trade_pricing_discount_percentage
                      assign original_price = target.price | times: 100 | divided_by: discount_factor
                    %}
                    
                    {% if original_price > 0 %}
                      <span class="sale-price">{{ money_price }}</span>
                      <span class="old-price">{{ original_price | money_without_trailing_zeros }}</span>
                      <span class="percentage-off">({{ trade_pricing_discount_percentage }}% off Trade Price)</span>
                    {% else %}
                      {% render 'price', product: product, use_variant: true, show_badges: true, price_class: '' %}
                    {% endif %}
                  {% elsif product.selected_or_first_available_variant.metafields.custom.last_chance_price.value != blank and product.price > product.selected_or_first_available_variant.metafields.custom.last_chance_price.value %}
                    {% liquid
                      assign sale_price = product.selected_or_first_available_variant.metafields.custom.last_chance_price.value | times: 1.0
                      assign percent_off = product.price | minus: sale_price | times: 100.0 | divided_by: product.price | round 
                    %}
                    <span class="sale-price">{{ product.selected_or_first_available_variant.metafields.custom.last_chance_price.value | money_without_trailing_zeros }}</span>
                    <span class="old-price">{{ product.price | money_without_trailing_zeros }}</span>
                    <span class="percentage-off">({{ percent_off }}% off)</span>
                  {% else %}
                    {%- liquid
                      # Same discount sources price.liquid renders: auto discount metafield, then compare-at.
                      assign variant_price = product.selected_or_first_available_variant.price
                      assign compare_at = product.selected_or_first_available_variant.compare_at_price
                      assign auto_discount_price = product.metafields.custom.auto_discount_price
                      assign percent_off = 0
                      if settings.enable_auto_discount_price and auto_discount_price > 0
                        assign auto_discount_cents = auto_discount_price | times: 100
                        if variant_price > auto_discount_cents
                          assign percent_off = variant_price | minus: auto_discount_cents | times: 100.0 | divided_by: variant_price | round
                        endif
                      elsif compare_at > variant_price
                        assign percent_off = compare_at | minus: variant_price | times: 100.0 | divided_by: compare_at | round
                      endif
                    -%}
                    {% render 'price', product: product, use_variant: true, show_badges: true, price_class: '' %}
                    {% if percent_off > 0 %}
                      <span class="percentage-off">({{ percent_off }}% off)</span>
                    {% endif %}
                  {%  endif  %}
                </div>

                {% unless customer and customer.b2b? %}
                  <span class="product__price-reviews-divider blue"> | </span>
                {% endunless %}

                {% comment %} Start of Judge.me code {% endcomment %}
                <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}'> 
                  {% render 'judgeme-badge-no-schema', product: product %} 
                </div> 
                {% comment %} End of Judge.me code {% endcomment %}
                
              </div>
            {% endunless %}

            {% if grouped_collection.metafields.custom.short_description != blank or product.description != blank %}
              <div class="product__description body blue">
                {{ grouped_collection.metafields.custom.short_description | default: product.description }}
              </div>
            {% endif %}
            {% unless section.settings.hide_dimensions == true %}
            <div class="product__dimensions--wrapper">
              <div class="dimensions__button">
                {%- render 'icon' with 'ruler' -%}
                <p>Need help finding the right dimension?</p>
                <div id="btnhomeModal" class="button">see dimensions</div>
              </div>
            </div>
            {% endunless %}
            {% if section.settings.text_dimensions == true %}
            <p id="btnhomeModal2" class="body"><span>Dimensions:</span> <u>view here</u></p>
            {% endif %}
            <div id="myModal" class="dimension-modal-content dimension_modal">
                  <div class="dimension-modal-header">
                  {% if product.title contains 'Porter' %}
                    <h6>The Porter Mat</h6>
                  {% else %}
                    <h6>{{ grouped_collection.title | remove: ' |' | default: product.title }}</h6>
                  {% endif %}
                  <div class="cancel-button close"><button class="cancel-icon">{% render 'icon' with 'close-circle' %}<span class="sr-only">Close Button</span></button></div>
                  </div>
                  <div class="dimension-modal-body">
                  <p>{{ product.metafields.custom.product_dimensions.value.dimension }}</p>
                  <img src="{{ product.metafields.custom.product_dimensions.value.dimension_image | img_url:'original' }}" alt="Dimension Image">
                  </div> 
              </div>
            {% for option in product.options_with_values %}
              {% unless product.tags contains 'Swatch' %}
              <div class="product__variant-name body" aria-label="Selected {{ option.name }}: {{ option.selected_value }}">
                {% if option.name == 'Size' %}
                  {% continue %}
                {% endif %}
                <span>
                  {%- if option.name == 'Color' or option.name == 'color' -%}
                    {%- if product.title contains 'Outlier' or product.title contains 'Outsider' -%}
                      {{ option.name }}
                    {% else %}
                      Style
                    {%- endif -%}
                  {%- else -%}
                      {{ option.name }}
                  {%- endif -%}
                </span>
                <span> — {{ option.selected_value }}</span>
              </div>
              {% endunless %}
            {% endfor %}

            {% if product.metafields.custom.style_text != blank %}
            <p class="style-text__color">{{ product.metafields.custom.style_text }}</p>
            {% endif %} 

            <div id="active-color" 
              data-color="{{ product.options_by_name['Color'].selected_value | default: product.options_by_name['Style'].selected_value }}">
            </div>

            {% assign has_new_tag = false %}
            {% for swatch in grouped_collection.products %}
              {% for tag in swatch.tags %}
                {% assign tag_lower = tag | downcase %}
                {% if tag_lower == 'new' %}
                  {% assign has_new_tag = true %}
                {% endif %}
              {% endfor %}
            {% endfor %}
            <div class="product__swatches {% if has_new_tag %} product__swatches--new{% endif %}{% if hidden_swatch_count > 0 %} product__swatches--collapsed{% endif %}">
              {{ color_swatch_list }}
            </div>

            {%- if hidden_swatch_count > 0 -%}
              <script>
                document.addEventListener('click', function (event) {
                  var button = event.target.closest('[data-swatch-reveal]');
                  if (!button) return;
                  var swatches = document.querySelectorAll('.product__swatch--extra');
                  swatches.forEach(function (swatch) {
                    swatch.classList.remove('hidden');
                  });
                  var group = document.querySelector('.product__swatches');
                  if (group) group.classList.remove('product__swatches--collapsed');
                  button.setAttribute('aria-expanded', 'true');
                  button.hidden = true;
                });
              </script>
              <button
                type="button"
                class="product__swatches-more"
                data-swatch-reveal
                aria-expanded="false"
              >
                Explore other {{ product_line_name | default: 'available' }} patterns
                <span class="product__swatches-more-arrow" aria-hidden="true">&nbsp;&nbsp;&rarr;</span>
              </button>
            {%- endif -%}

            {% comment %}
            <div>
              {% form 'product', product, id: 'product-form-installment', class: 'installment' %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {{ form | payment_terms }}
              {% endform %}
            </div>
            {% endcomment %}

            {% unless product.tags contains 'Swatch' %}
            <product-form class="product-form">
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-error" viewBox="0 0 13 13">
                  <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                  <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                  <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                  <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
                </svg>
                <span class="product-form__error-message"></span>
              </div>

              {% form 'product',
                product,
                id: product_form_id,
                class: 'form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {% render 'final-sale-property-input', product: product %}

                {% unless product.has_only_default_variant %}
                  {% assign picker_type = 'button' %}
                  {% if picker_type == 'button' %}
                    <variant-radios
                      class="no-js-hidden visually-hidden"
                      data-section="{{ section.id }}"
                      data-url="{{ product.url }}"
                    >
                      {% for option in product.options_with_values %}
                        <fieldset class="js product-form__input">
                          <legend class="form__label">{{ option.name }}</legend>
                          {% for value in option.values %}
                            <input
                              type="radio"
                              id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                              name="{{ option.name }}"
                              value="{{ value | escape }}"
                              form="{{ product_form_id }}"
                              {% if option.selected_value == value %}
                                checked
                              {% endif %}
                            >
                            <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
                              {{ value }}
                            </label>
                          {% endfor %}
                        </fieldset>
                      {% endfor %}
                      <script type="application/json">
                        {{ product.variants | json }}
                      </script>
                    </variant-radios>
                  {% else %}
                    <variant-selects
                      class="no-js-hidden visually-hidden"
                      data-section="{{ section.id }}"
                      data-url="{{ product.url }}"
                    >
                      {% for option in product.options_with_values %}
                        <div class="product-form__input product-form__input--dropdown">
                          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
                            {{ option.name }}
                          </label>
                          <div class="select">
                            <select
                              id="Option-{{ section.id }}-{{ forloop.index0 }}"
                              class="select__select"
                              name="options[{{ option.name | escape }}]"
                              form="{{ product_form_id }}"
                            >
                              {% for value in option.values %}
                                <option
                                  value="{{ value | escape }}"
                                  {% if option.selected_value == value %}
                                    selected="selected"
                                  {% endif %}
                                >
                                  {{ value }}
                                </option>
                              {% endfor %}
                            </select>
                            {% render 'icon', icon: 'caret' %}
                          </div>
                        </div>
                      {% endfor %}

                      <script type="application/json">
                        {{ product.variants | json }}
                      </script>
                    </variant-selects>
                  {% endif %}
                {% endunless %}

                <noscript class="product-form__noscript-wrapper-{{ section.id }}">
                  <div class="product-form__input{% if product.has_only_default_variant %} hidden{% endif %}">
                    <label class="form__label" for="Variants-{{ section.id }}">
                      {{- 'products.product.product_variants' | t -}}
                    </label>
                    <div class="select">
                      <select name="id" id="Variants-{{ section.id }}" class="select__select" form="{{ product_form_id }}">
                        {% for variant in product.variants %}
                          <option
                            {% if variant == product.selected_or_first_available_variant %}
                              selected="selected"
                            {% endif %}
                            {% if variant.available == false %}
                              disabled
                            {% endif %}
                            value="{{ variant.id }}"
                          >
                            {{ variant.title }}
                            {% if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
                            - {{ variant.price | money | strip_html }}
                          </option>
                        {% endfor %}
                      </select>
                      {% render 'icon', icon: 'caret' %}
                    </div>
                  </div>
                </noscript>
              
                <!-- Shop Other Sizes -->
                {% liquid
                  assign product_type = grouped_collection.title | remove: 'The ' | split: ' | '
                  assign active_style = product.selected_or_first_available_variant.title
                  assign product_size = product.options_by_name['size'].values[0]
                  assign active_style = active_style | remove: product_size | remove: " / " 
                  assign other_sizes = grouped_collection.metafields.custom.other_sizes.value
                %}

                <span data-idd="{{ grouped_collection }}" data-active-style="{{ active_style }}"></span>

                  {% if other_sizes != blank and section.settings.shop_more_below != true %}
                    {% capture other_size_links %}
                      {% for block in other_sizes %}
                        {% assign current_size = block.title | split: " | " %}
                        {% assign format_color = "- " | append: active_style | append: " /" %}
                        {%  assign match_name = block.title | replace: "|", format_color %}
                        {%  assign match = block.products | where: 'title', match_name %}
                        {% if match != blank %}
                          <a class="inline-link" href="{{ match.first.url }}">{{ current_size.last }}</a> <span class="other-size__divider">or</span>
                        {% endif %}
                      {% endfor %}
                    {%  endcapture %}

                    {% unless section.settings.hide_shop_other == true %}
                      {% unless other_size_links == blank %}
                        <div class="other-sizes__wrapper">
                          <span>Also available in:</span> {{ other_size_links }}
                        </div>
                      {% endunless %}
                    {% endunless %}
                  {% endif %}

                {% if product.metafields.custom.restock_date != blank %}
                  <p class="product__restock-note body">{{ product.metafields.custom.restock_date }}</p>
                {% endif %}

                {% assign small_text_1 = 0 %}
                
                {% for block in other_sizes %}              
                  {%- assign current_size = block.title | split: " | " -%}
                  {%- assign format_color = "- " | append: active_style | append: " /" -%}
                  {%- assign match_name = block.title | replace: "|",  format_color -%}
                  {%- assign match = block.products | where: 'title', match_name -%}
                  {% if match != blank %}
                    {% assign small_text_1 = small_text_1 | plus: 1 %}
                  {% endif %}
                {% endfor %}

                {%- if other_sizes != blank and section.settings.shop_more_below == true -%}
                  {%- capture other_size_links -%}
                    {%- comment -%} Current Product Size {%- endcomment -%}
                      {% assign active_order = '' %}
                      {% if product.handle contains '3-x-5' %}
                        {% assign active_order = 2 %}
                      {% elsif product.handle contains 'doormat' %}
                        {% assign active_order = 1 %}
                      {% elsif product.handle contains 'xl-runner' %}
                        {% assign active_order = 4 %}
                      {% elsif product.handle contains 'runner' %}
                        {% assign active_order = 3 %}
                      {% elsif product.handle contains 'area-mat-5x7' %}
                        {% assign active_order = 8 %}
                      {% elsif product.handle contains 'area-mat' %}
                        {% assign active_order = 5 %}
                      {% elsif product.handle contains 'standard' %}
                        {% assign active_order = 6 %}
                      {% elsif product.handle contains 'double' %}
                        {% assign active_order = 7 %}
                      {% endif %}

                    <product-swatch 
                      style="order: {{ active_order }};"
                      class="{% if small_text_1 == 3 %}small_button_text{% endif %} other-sizes__button active"
                      data-href="{{ product.url }}"
                    >
                      {% render 'product-size-icon', size_name: product_size %}
                      <span class="visually-hidden">{{ product_size }}</span>
                      {% render 'product-other-size-dimension', dimension_product: product %}
                    </product-swatch>

                    {%- comment -%} Other Sizes {%- endcomment -%}
                    {%- for block in other_sizes -%}
                      {%- assign current_size = block.title | split: " | " -%}
                      {%- assign format_color = "- " | append: active_style | append: " /" -%}
                      {%- assign match_name = block.title | replace: "|",  format_color -%}
                      {%- assign alternate_match_name = match_name | split: "/" | first | strip -%}
                      {%- assign match = block.products | where: 'title', match_name -%}
                      {%- assign alternate_match = "" -%}

                      {% for p in block.products %}
                        {% if p.title == match_name %}
                          {%- assign alternate_match = p -%}
                        {% endif %}
                      {% endfor %}

                      {%- if match != blank or alternate_match != blank -%} 
                      {% assign prod_url = blank %}
                      {% if match != blank %}
                        {% assign prod_url = match.first.url %}
                      {% elsif alternate_match != blank %}
                        {% assign prod_url = alternate_match.url %}
                      {% endif %}

                      {%- if prod_url != blank and prod_url != product.url -%}
                        <product-swatch 
                          style="order: {% if current_size[1] == 'Doormat' %}1{% elsif current_size[1] == '3 x 5 Doormat'  %}2{% elsif current_size[1] == 'Runner'  %}3{% elsif current_size[1] == 'XL Runner'  %}4{% elsif current_size[1] == 'Area Mat'  %}5{% elsif current_size[1] == 'Standard'  %}6{% elsif current_size[1] == 'Double'  %}7{% elsif current_size[1] == '5 x 7 Area Mat'  %}8{% endif %} ;"
                          class="{% if small_text_1 == 3 %}small_button_text{% endif %} other-sizes__button" 
                          data-href="{{ prod_url }}"
                        >
                          {% render 'product-size-icon', size_name: current_size.last %}
                          <span class="visually-hidden">{{ current_size.last }}</span>

                          {% liquid
                            assign dimension_product = nil
                            if match != blank
                              assign dimension_product = match.first
                            elsif alternate_match != blank
                              assign dimension_product = alternate_match
                            endif
                          %}
                          {% render 'product-other-size-dimension', dimension_product: dimension_product %}
                        </product-swatch>
                      {%- endif -%}
                      
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endcapture -%}


                  {%- unless section.settings.hide_shop_other == true -%}
                    {%- unless other_size_links == blank -%}
                      <div class="other-sizes__wrapper other-sizes__wrapper--other-collections">
                        {%- liquid
                          # Mockup's "Size — Doormat". The name of the size option, not its
                          # dimensions, shortened the same way the cards used to be.
                          assign size_label_value = product_size
                          if product_size == '5 x 7 Area Mat'
                            assign size_label_value = 'Area Mat'
                          elsif product_size == '3 x 5 Doormat'
                            assign size_label_value = 'Doormat'
                          endif
                        -%}
                        {%- if size_label_value != blank -%}
                          <span class="other-sizes__label">Size &mdash; <span class="other-sizes__label-value">{{ size_label_value }}</span></span>
                        {%- endif -%}
                        <div class="other-sizes__wrapper-links">
                          {{ other_size_links }}
                        </div>
                      </div>
                    {%- endunless -%}
                  {%- endunless -%}
                {%- elsif product.type == 'Outlier' and section.settings.shop_more_below == true  -%}  
                  {%- capture other_size_links -%}
                    <a 
                      class="other-sizes__button active" 
                      href="{{ product.url }}"
                    >
                      <span>{{ product_size }}</span>
                      {% render 'product-other-size-dimension', dimension_product: product %}
                    </a>
                    {%- endcapture -%}
                    {%- unless other_size_links == blank -%}
                      <div class="other-sizes__wrapper other-sizes__wrapper--other-collections">
                        <div class="6 other-sizes__wrapper-links">
                          {{ other_size_links }}
                        </div>
                      </div>
                    {%- endunless -%}
        
                {%- endif -%}

                {% render 'final-sale-notice', product: product %}

                <div class="product__quantity-atc-wrapper  {% if product.available == false %}bis-styles{% endif %} {% if section.settings.hide_quantity == true %}no-quant__button{% endif %}">
                  <div class="product-form__input product-form__quantity {% if product.available == false or section.settings.hide_quantity == true %}visually-hidden{% endif%}">
                    <label class="form__label visually-hidden" for="Quantity-{{ section.id }}">
                      {{ 'products.product.quantity.label' | t }}
                    </label>
                    <quantity-input class="quantity">
                      <button class="quantity__button no-js-hidden" name="minus" type="button">
                        <span class="visually-hidden">
                          {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                        </span>
                        {% render 'icon', icon: 'minus' %}
                      </button>
                      <input
                        class="quantity__input"
                        type="number"
                        name="quantity"
                        id="Quantity-{{ section.id }}"
                        min="1"
                        value="1"
                        form="{{ product_form_id }}"
                      >
                      <button class="quantity__button no-js-hidden" name="plus" type="button">
                        <span class="visually-hidden">
                          {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                        </span>
                        {% render 'icon', icon: 'plus' %}
                      </button>
                    </quantity-input>
                  </div>

                  <div class="product-form__buttons">
                    <button
                      type="submit"
                      name="add"
                      class="product-form__submit button {% if section.settings.show_dynamic_checkout and product.selling_plan_groups == empty %}button--secondary{% else %}button--primary{% endif %}"
                      {% if product.selected_or_first_available_variant.available == false %}
                        disabled
                      {% endif %}
                    >
                      
                      <span>
                        {% if product.selected_or_first_available_variant.inventory_policy == 'continue' and product.selected_or_first_available_variant.inventory_quantity <= 0 %}
                          PREORDER
                        {% else %}
                          {% if product.selected_or_first_available_variant.available %}
                          {{ 'products.product.add_to_cart' | t }}
                        {% else %}
                          {{ 'products.product.sold_out' | t }}
                        {% endif %}
                        {% endif %}
              
                      </span>
                      <span> | </span>
                      <span>

                        {% if product.selected_or_first_available_variant.metafields.custom.last_chance_price.value != blank and product.price > product.selected_or_first_available_variant.metafields.custom.last_chance_price.value %}
                          <span>{{ product.selected_or_first_available_variant.metafields.custom.last_chance_price.value | money_without_trailing_zeros }}</span>
                        {% else %}
                          {% render 'price', product: product, use_variant: true, show_badges: false, price_class: '', ATC_button: true %}
                      {%  endif %}
                      </span>
                      <div class="loading-overlay__spinner">
                        <svg
                          aria-hidden="true"
                          focusable="false"
                          role="presentation"
                          class="spinner"
                          viewBox="0 0 66 66"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                        </svg>
                      </div>
                    </button>
                    {% if section.settings.show_dynamic_checkout %}
                      {{ form | payment_button }}
                    {% endif %}
                  </div>
                </div>

                <div class="afterpay-wrapper"></div>
              {% endform %}
            </product-form>
          {% endunless %}

          {%- if section.settings.show_delivery_estimate and is_preorder == false -%}
            {%- comment -%}
              Dates are worked out in the browser (assets/pdp-delivery-estimate.js) from
              the buyer's own "today"; the element stays hidden until they are in.
            {%- endcomment -%}
            <delivery-estimate
              class="product__delivery-estimate"
              data-min-days="{{ section.settings.delivery_days_min }}"
              data-max-days="{{ section.settings.delivery_days_max }}"
              hidden
            >
              <svg class="product__delivery-estimate-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                <path d="M2 7h14v10H2z" stroke-linejoin="round"/>
                <path d="M16 7h4l2 4v6h-6z" stroke-linejoin="round"/>
                <circle cx="5" cy="19" r="2"/>
                <circle cx="18" cy="19" r="2"/>
                <path d="M7 19h11" stroke-linecap="round"/>
              </svg>
              <span class="product__delivery-estimate-text" data-delivery-text></span>
            </delivery-estimate>
          {%- endif -%}

          {%- comment -%}
            App blocks (e.g. the estimated delivery date app) render under the buy buttons.
            Merchants place them from the theme editor; the theme renders no date itself.
            They sit outside the product form so an app's own form is never nested inside it.
          {%- endcomment -%}
          {%- if section.blocks.size > 0 -%}
            <div class="product__app-blocks">
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when '@app' -%}
                    <div class="product__app-block" {{ block.shopify_attributes }}>{% render block %}</div>
                {%- endcase -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          </div>
          {% comment %}
          {% if product.available == false %}
            <div class="product__oos-notify-wrapper">
              <p class="body">Notify me when THIS STYLE IS back in stock:</p>
              <div id="NotifyMe_form" class="NotifyMe_form">
                <input
                  class="notify-email-val"
                  type="email"
                  id="notify_email"
                  name="email"
                  placeholder="Email Address"
                  class="email"
                  required
                >
                <input
                  class="notify-me-var"
                  type="hidden"
                  id="notify_id"
                  name="variant"
                  value="{{ product.variants[0].id }}"
                >
                <button type="button" class="text-link" value="Submit" data-bis-button>Submit ></button>
                <div class="notifyme_error"></div>
              </div>
            </div>
          {% elsif oos_products.size > 0 %}
          <div class="product__oos-notify-wrapper">
            <p class="body"><button data-modal-trigger="notify-me" >Notify me</button> when out of stock styles are back in stock</p>
          </div>
          {% endif %}
          {% endcomment %}

          {% comment %}ACCORDION BEGINS{% endcomment %}
          {% unless product.tags contains 'Swatch' %}
          <pdp-accordion class="product-accordion__container">
            {% if grouped_collection.metafields.custom.product_features != blank %}
            <div class="accordion">
              <div data-id="1" class="accordion-title">
                <h2 class="h3">Features</h2>
                {% render 'icon', icon: 'caret' %}
              </div>
              <div data-id="1" class="accordion-content active">
                <div class="swiper-slide">
                      <div class="product__tabs-item">
                        <div class="product__features">
                          {% if product.handle contains 'outsider' %}
                            <div class="product__features-item">
                              <p class="body-sm">Have an Outsider mat but need a new insert? <a href="/products/outsider-insert-replacement">Click here</a> to shop!</p>
                            </div>
                          {% else %}
                            {% for feature in grouped_collection.metafields.custom.product_features.value %}
                              <div class="product__features-item">
                                {% if feature.image != blank %}{{ feature.image | image_url: width: 206 | image_tag: width: 103 }}{% endif %}
                                <p class="body-sm">{{ feature.label }}</p>
                              </div>
                            {% endfor %}
                          {% endif %}
                        </div>
                      </div>
                    </div>
              </div>
            </div>
            {% endif %}
          
            <div class="accordion">
              <div data-id="2" class="accordion-title">
                <h2 class="h3">Materials &amp; Construction</h2>
                {% render 'icon', icon: 'caret' %}
              </div>
              <div data-id="2" class="accordion-content">
                <div class="swiper-slide">
                  <div class="product__tabs-item body-sm">
                    {{ section.settings.materials }}
                  </div>
                </div>
              </div>
            </div>
          
            {% if grouped_collection.metafields.custom.dimensions != blank %}
            <div class="accordion">
              <div data-id="3" class="accordion-title">
                <h2 class="h3">Fit &amp; Dimensions</h2>
                {% render 'icon', icon: 'caret' %}
              </div>
              <div data-id="3" class="accordion-content">
                <div class="swiper-slide">
                  <div class="product__tabs-item">
                    <p class="body-sm">
                      Dimensions: {{ grouped_collection.metafields.custom.dimensions | newline_to_br }}
                      {% if grouped_collection.metafields.custom.additional_dimensions != blank %}
                        <br>
                        {{ grouped_collection.metafields.custom.additional_dimensions | newline_to_br }}
                      {% endif %}
                      {% if grouped_collection.metafields.custom.weight != blank %}
                        <br>
                        Weight: {{ grouped_collection.metafields.custom.weight }}
                      {% endif %}
                      {% if grouped_collection.metafields.custom.thickness != blank %}
                        <br>
                        Thickness: {{ grouped_collection.metafields.custom.thickness | metafield_tag }}
                      {% endif %}
                    </p>
                  </div>
                </div>
              </div>
            </div>
            {% endif %}

            {% if section.settings.care != blank %}
            <div class="accordion">
              <div data-id="4" class="accordion-title">
                <h2 class="h3">Care &amp; Cleaning</h2>
                {% render 'icon', icon: 'caret' %}
              </div>
              <div data-id="4" class="accordion-content">
                <div class="swiper-slide">
                  <div class="product__tabs-item body-sm">
                    {{ section.settings.care }}
                  </div>
                </div>
              </div>
            </div>
            {% endif %}

            <div class="accordion">
              <div data-id="5" class="accordion-title">
                <h2 class="h3">Shipping &amp; Returns</h2>
                {% render 'icon', icon: 'caret' %}
              </div>
              <div data-id="5" class="accordion-content">
                <div class="swiper-slide">
                  <div class="product__tabs-item body-sm">
                    {%- if shipping_returns_metafield != blank -%}
                      {{ shipping_returns_metafield | metafield_tag }}
                    {%- else -%}
                      {{ section.settings.shipping_returns }}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>

            <div class="accordion">
              <div data-id="6" class="accordion-title">
                <h2 class="h3">FAQs</h2>
                {% render 'icon', icon: 'caret' %}
              </div>
              <div data-id="6" class="accordion-content">
                <div class="swiper-slide">
                  <div class="product__tabs-item body-sm">
                    {%- if faqs_metaobjects != blank -%}
                      {%- comment -%}
                        Same field access as the faq section's repeater blocks:
                        question as plain text, answer through metafield_tag.
                      {%- endcomment -%}
                      {%- for faq in faqs_metaobjects -%}
                        <div class="product__faq-item">
                          <p class="product__faq-question">{{ faq.question.value }}</p>
                          <div class="product__faq-answer">{{ faq.answer | metafield_tag }}</div>
                        </div>
                      {%- endfor -%}
                    {%- else -%}
                      {{ section.settings.faqs }}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>

            {% comment %}
            {% if product.handle contains "outlier" %}
            <div class="accordion">
              <div data-id="5" class="accordion-title">
                <h3>Warranty</h3>
                {% render 'icon', icon: 'caret' %}
              </div>
              <div data-id="5" class="accordion-content">
                <div class="swiper-slide">
                  <div class="product__tabs-item body-sm">
                    <a href="/pages/outlier-warranty">Outlier Warranty</a>
                  </div>
                </div>
              </div>
            </div>
            {% endif %}
            {% endcomment %}
          </pdp-accordion>
          {% endunless %}
          {% comment %}ACCORDION ENDS{% endcomment %}         
        </div>
      </div>
    </section>

    <sticky-atc
      class=""
      data-main-form="{{product_form_id}}"
      data-section-id="{{ section.id }}"
      style="display: none"
    >
      <div class="product__quantity-atc-wrapper">
        <div class="product-form__input product-form__quantity">
          <label class="form__label visually-hidden" for="sticky-Quantity-{{ section.id }}">
            {{ 'products.product.quantity.label' | t }}
          </label>
          <quantity-input class="quantity">
            <button class="quantity__button no-js-hidden" name="minus" type="button">
              <span class="visually-hidden">
                {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
              </span>
              {% render 'icon', icon: 'minus' %}
            </button>
            <input
              class="quantity__input"
              type="number"
              name="quantity"
              id="sticky-Quantity-{{ section.id }}"
              min="1"
              value="1"
              form="{{ product_form_id }}"
            >
            <button class="quantity__button no-js-hidden" name="plus" type="button">
              <span class="visually-hidden">
                {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
              </span>
              {% render 'icon', icon: 'plus' %}
            </button>
          </quantity-input>
        </div>

        <div class="product-form__buttons">
          <button
            name="add"
            class="button button--full button--primary product-form__submit"
            {% if product.selected_or_first_available_variant.available == false %}
              disabled
            {% endif %}
          >
            <span>
              {% if product.selected_or_first_available_variant.inventory_policy == 'continue' and product.selected_or_first_available_variant.inventory_quantity <= 0 %}
                PREORDER
              {% else %}
                  {% if product.selected_or_first_available_variant.available %}
                    {{ 'products.product.add_to_cart' | t }}
                  {% else %}
                    {{ 'products.product.sold_out' | t }}
                  {% endif %}
                {% endif %}
            </span>
            <span> | </span>
            <span>
              {% render 'price', product: product, use_variant: true, show_badges: false, price_class: '' %}
            </span>
            <div class="loading-overlay__spinner">
              <svg
                focusable="false"
                role="presentation"
                class="spinner"
                viewBox="0 0 66 66"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
              </svg>
            </div>
          </button>
        </div>
      </div>
    </sticky-atc>

    {% if oos_products.size > 0 and product.available != false %}
      {% render 'notify-me-modal', products: oos_products %}
    {% endif %}

    {% render 'product-zoom' %}

    <div class="loading-overlay">
      <div class="loading-overlay__spinner">
        <svg
          aria-hidden="true"
          focusable="false"
          role="presentation"
          class="spinner"
          viewBox="0 0 66 66"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
        </svg>
      </div>
    </div>
  </product-section>
</div>

{% liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
%}


{% comment %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    {% if seo_media %}
      {% assign media_size = seo_media.preview_image.width | append: 'x' %}
      "image": [
        {{ seo_media | img_url: media_size | prepend: "https:" | json }}
      ],
    {% endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank %}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {% endif %}
    "brand": {
      "@type": "Thing",
      "name": {{ product.vendor | json }}
    },
    "offers": [
      {% for variant in product.variants %}
        {
          "@type" : "Offer",
          {% if variant.sku != blank %}
            "sku": {{ variant.sku | json }},
          {% endif %}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>


"priceSpecification": {
            "@type": "PriceSpecification",
            "price": {{ variant.price | divided_by: 100.00 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "priceValidUntil": {{ 'now' | date: '%Y-%m-%d' | json  }},
            "paymentOption": "Installments",
            "installment": {
              "@type": "MonetaryAmount",
              "currency": {{ cart.currency.iso_code | json }},
              "value": {{ variant.price | divided_by: 400.00 | json }}
            },
            "installmentFrequency": "https://schema.org/Monthly",
            "totalPrice": {{ variant.price | divided_by: 100.00 | json }},
            "installmentPaymentDueDate": {{ 'now' | date: '%Y-%m-%d' | json  }}
          }

{% endcomment %}

{%- liquid
  if product.featured_image
    assign seo_image_url = product.featured_image | image_url: width: 1920
    unless seo_image_url contains 'http'
      assign seo_image_url = seo_image_url | prepend: 'https:'
    endunless
  endif
  assign review_rating_value = blank
  if product.metafields.reviews.rating.value.rating != blank
    assign review_rating_value = product.metafields.reviews.rating.value.rating
  endif
  assign review_count_value = blank
  if product.metafields.reviews.rating_count.value != blank
    assign review_count_value = product.metafields.reviews.rating_count.value
  elsif product.metafields.reviews.rating_count != blank
    assign review_count_value = product.metafields.reviews.rating_count
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": {{ canonical_url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      "image": {{ seo_image_url | json }},
      "description": {{ product.description | strip_html | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | json }}
      },
      {% comment %} {%- if review_rating_value != blank and review_count_value != blank and review_count_value > 0 -%}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ review_rating_value | json }},
        "reviewCount": {{ review_count_value | json }}
      },
      {%- endif -%} {% endcomment %}
      "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}
          "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
          "gtin12": {{ variant.barcode | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
          "gtin13": {{ variant.barcode | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
          "gtin14": {{ variant.barcode | json }},
          {%- endif -%}
          "price": {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "priceValidUntil": {{ 'now' | date: '%s' | plus: 2592000 | date: '%Y-%m-%d' | json }},
          "url": {{ request.origin | append: variant.url | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "shippingDetails": { "@id": "#shipping_policy" },
          "hasMerchantReturnPolicy": { "@id": "#return_policy" }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
      ]
    },
    {
      "@type": "OfferShippingDetails",
      "@id": "#shipping_policy",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": 0,
        "currency": {{ cart.currency.iso_code | json }}
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "US"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 2,
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 2,
          "unitCode": "DAY"
        }
      }
    },
    {
      "@type": "MerchantReturnPolicy",
      "@id": "#return_policy",
      "applicableCountry": "US",
      "returnPolicyCountry": "US",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  ]
}
</script>




{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "product-section",
  "blocks": [{ "type": "@app" }],
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Connect collection for metafield access"
    },
    {
      "type": "richtext",
      "id": "materials",
      "label": "Materials",
      "info": "Connect collection metafields for Materials"
    },
    {
      "type": "richtext",
      "id": "care",
      "label": "Care",
      "info": "Connect collection metafields for care"
    },
    {
      "type": "checkbox",
      "id": "hide_pinterest",
      "label": "Hide Pinterest",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_dimensions",
      "label": "Hide Dimensions Box",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "text_dimensions",
      "label": "Show Text Dimensions",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_shop_other",
      "label": "Hide Shop Other Sizes",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_quantity",
      "label": "Hide Quantity Selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "shop_more_below",
      "label": "Move Shop Other to Bottom",
      "default": false
    },
    {
      "type": "header",
      "content": "Estimated delivery"
    },
    {
      "type": "checkbox",
      "id": "show_delivery_estimate",
      "label": "Show estimated delivery date",
      "default": true
    },
    {
      "type": "range",
      "id": "delivery_days_min",
      "label": "Minimum delivery days",
      "info": "Business days; weekends are skipped.",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "delivery_days_max",
      "label": "Maximum delivery days",
      "info": "Business days; weekends are skipped.",
      "min": 1,
      "max": 45,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "info": "Shows Shop Pay and the customer's other express checkout methods under Add to Cart.",
      "default": true
    },
    {
      "type": "header",
      "content": "Accordions"
    },
    {
      "type": "html",
      "id": "shipping_returns",
      "label": "Shipping & Returns fallback",
      "info": "Used only when the collection metafield custom.shipping_returns is empty."
    },
    {
      "type": "html",
      "id": "faqs",
      "label": "FAQs fallback",
      "info": "Used only when the collection's FAQ metaobject list (custom.faqs) is empty."
    }
  ]
}
{% endschema %}
