{%- liquid
  assign desktop_video = section.settings.video
  assign mobile_video = section.settings.mobile_video
  assign has_mobile_video = false
  if desktop_video != blank and mobile_video != blank and mobile_video.id != desktop_video.id
    assign has_mobile_video = true
  endif

  # Prefer Shopify video preview frames for LCP (not blank white merchant posters).
  if has_mobile_video and mobile_video.preview_image != blank
    assign poster_mobile_image = mobile_video.preview_image
  elsif desktop_video.preview_image != blank
    assign poster_mobile_image = desktop_video.preview_image
  elsif section.settings.video_poster != blank
    assign poster_mobile_image = section.settings.video_poster
  endif

  if desktop_video.preview_image != blank
    assign poster_desktop_image = desktop_video.preview_image
  elsif section.settings.video_poster != blank
    assign poster_desktop_image = section.settings.video_poster
  else
    assign poster_desktop_image = poster_mobile_image
  endif

  if poster_mobile_image != blank
    assign poster_url_mobile = poster_mobile_image | image_url: width: 750
  endif
  if poster_desktop_image != blank
    assign poster_url_desktop = poster_desktop_image | image_url: width: 1200
  endif

  assign poster_alt = section.settings.title | strip_html | default: shop.name
  assign captions_url = 'hero-captions-en.vtt' | file_url
-%}

{%- comment -%}
  LCP surface is the poster <img>, not the <video>. Preload the viewport-matched
  poster early. Video bytes load after LCP via preload="none" + idle/visible init.
{%- endcomment -%}
{%- if desktop_video != blank and poster_url_mobile != blank -%}
  {%- if has_mobile_video and poster_url_desktop != blank -%}
    <link
      rel="preload"
      as="image"
      href="{{ poster_url_mobile }}"
      media="(max-width: 768px)"
      fetchpriority="high"
    >
    <link
      rel="preload"
      as="image"
      href="{{ poster_url_desktop }}"
      media="(min-width: 769px)"
      fetchpriority="high"
    >
  {%- else -%}
    <link
      rel="preload"
      as="image"
      href="{{ poster_url_desktop | default: poster_url_mobile }}"
      fetchpriority="high"
    >
  {%- endif -%}
{%- endif -%}

{{ 'section-video-text.css' | asset_url | stylesheet_tag }}

<section class="Section {{ section.settings.custom-class }} video-text" id="VideoText-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  {%- capture css_variables -%}
    --title_fz: {{ section.settings.title_font_size }}px;
    --content_fz: {{ section.settings.content_font_size }}px;
    --content_fz_mb: {{ section.settings.content_font_size_mb }}px;
  {%- endcapture -%}

  {%- capture section_content -%}
    <div class="FeatureText__ContentWrapper{% if section.settings.content_full_width %} FeatureText__ContentWrapper--full-width{% endif %}" style="{{- css_variables | strip_newlines -}}">
      <div class="FeatureText__Content">
        {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.content != blank -%}
          <header class="SectionHeader">
            {%- if section.settings.subheading != blank -%}
              <h4 class="SectionHeader__SubHeading">{{ section.settings.subheading }}</h4>
            {%- endif -%}

            {%- if section.settings.title != blank -%}
              <div class="SectionHeader__Heading">{{ section.settings.title }}</div>
            {%- endif -%}

            {%- if section.settings.content != blank -%}
              <div class="SectionHeader__Description">
                {{ section.settings.content }}
              </div>
            {%- endif -%}

            {%- if section.settings.link_text != blank -%}
              <a href="{{ section.settings.link_url }}" class="Link Link--underline button-{{ section.settings.button_style }}">{{ section.settings.link_text | escape }}</a>
            {%- endif -%}
          </header>
        {%- endif -%}
      </div>
    </div>
  {%- endcapture -%}

  {%- capture section_image -%}
    {%- if desktop_video != blank -%}
      {%- liquid
        assign ar_mobile_w = poster_mobile_image.width | default: 750
        assign ar_mobile_h = poster_mobile_image.height | default: 1000
        assign ar_desktop_w = poster_desktop_image.width | default: ar_mobile_w
        assign ar_desktop_h = poster_desktop_image.height | default: ar_mobile_h
      -%}
      <div
        class="FeatureText__ImageWrapper video-wrapper"
        style="--poster-ar-mobile: {{ ar_mobile_w }} / {{ ar_mobile_h }}; --poster-ar-desktop: {{ ar_desktop_w }} / {{ ar_desktop_h }};"
      >
        {%- if poster_url_mobile != blank or poster_url_desktop != blank -%}
          <picture>
            {%- if has_mobile_video and poster_url_mobile != blank -%}
              <source
                media="(max-width: 768px)"
                srcset="{{ poster_url_mobile }}"
              >
            {%- endif -%}
            <img
              class="hero-lcp-poster"
              src="{{ poster_url_desktop | default: poster_url_mobile }}"
              width="{{ ar_desktop_w }}"
              height="{{ ar_desktop_h }}"
              fetchpriority="high"
              decoding="async"
              alt="{{ poster_alt | escape }}"
            >
          </picture>
        {%- endif -%}

        <video
          data-hero-video
          id="video-hero-{{ section.id }}"
          class="videos"
          playsinline
          muted
          loop
          preload="none"
          {% if poster_url_desktop != blank %}
            poster="{{ poster_url_desktop }}"
          {% elsif poster_url_mobile != blank %}
            poster="{{ poster_url_mobile }}"
          {% endif %}
        >
          {%- if has_mobile_video -%}
            {%- for source in mobile_video.sources -%}
              <source
                src="{{ source.url }}"
                type="{{ source.mime_type }}"
                media="(max-width: 768px)"
              >
            {%- endfor -%}
            {%- for source in desktop_video.sources -%}
              <source
                src="{{ source.url }}"
                type="{{ source.mime_type }}"
                media="(min-width: 769px)"
              >
            {%- endfor -%}
          {%- else -%}
            {%- for source in desktop_video.sources -%}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          {%- endif -%}
          <track kind="captions" src="{{ captions_url }}" srclang="en" label="English" default>
        </video>
      </div>
    {%- endif -%}
  {%- endcapture -%}

  <div class="FeatureText hero-video-section{% if section.settings.media_first %} media-first{% endif %}">
      {{- section_content -}}
      {{- section_image -}}
  </div>
</section>

{% schema %}
{
  "name": "Video with text",
  "class": "image-with-text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Text Background Color"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile Video"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video Poster Image (fallback)",
      "info": "Optional. Prefer leaving blank — the theme uses each video's Shopify preview frame for LCP. Avoid blank/white images."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub-heading"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Heading",
      "default": "<p>Add Title...</p>"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size",
      "default": 72
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text",
      "default": "<p>Add your own custom content to give more information about your store, availability details...</p>"
    },
    {
      "type": "range",
      "id": "content_font_size",
      "min": 10,
      "max": 70,
      "step": 1,
      "unit": "px",
      "label": "Content Font Size",
      "default": 30
    },
    {
      "type": "range",
      "id": "content_font_size_mb",
      "min": 10,
      "max": 70,
      "step": 1,
      "unit": "px",
      "label": "Content Font Size Mobile",
      "default": 14
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "small"
    },
    {
      "type": "text",
      "id": "custom-class",
      "label": "custom-class"
    },
    {
      "type": "header",
      "content": "Config"
    },
    {
      "type": "checkbox",
      "id": "media_first",
      "label": "Media first on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "content_full_width",
      "label": "Content full width",
      "default": false
    }
  ],
  "presets": [
    {
      "category": "Text",
      "name": "Video with text",
      "settings": {}
    }
  ]
}
{% endschema %}

{% javascript %}
(function () {
  /*
    Breakpoint selection is Liquid + <source media> — no matchMedia JS.
    Do NOT call video.load()/play() on load/idle: decoding the ~3MB hero MP4
    creates long tasks inside the FCP→TTI window and spikes mobile TBT.
    Start playback only after a real user gesture (same gate as optimization.js).
  */
  var started = false;

  function loadAndPlay(video, wrapper) {
    if (!video || video.getAttribute('data-hero-loaded') === 'true') return;
    video.setAttribute('data-hero-loaded', 'true');

    try {
      video.load();
    } catch (e) {}

    video.addEventListener(
      'playing',
      function () {
        if (wrapper) wrapper.classList.add('is-playing');
      },
      { once: true }
    );

    var tryPlay = function () {
      if (typeof video.play !== 'function') return;
      var p = video.play();
      if (p && typeof p.catch === 'function') p.catch(function () {});
    };

    if (video.readyState >= 2) tryPlay();
    else video.addEventListener('loadeddata', tryPlay, { once: true });
  }

  function startAll() {
    if (started) return;
    started = true;
    document.querySelectorAll('section.video-text').forEach(function (section) {
      loadAndPlay(
        section.querySelector('video[data-hero-video]'),
        section.querySelector('.video-wrapper')
      );
    });
  }

  ['keydown', 'touchstart', 'click'].forEach(function (type) {
    window.addEventListener(type, startAll, { once: true, passive: true, capture: true });
  });
})();
{% endjavascript %}
