{%- liquid
  # Show collection only when visitor IS a registered B2B customer
  assign show_collection = false
  if customer and customer.b2b?
    assign show_collection = true
  endif

  assign swatch_collection = section.settings.collection
  if swatch_collection == blank and collection != blank
    assign swatch_collection = collection
  endif

  # Load more ON: page by the configured size. OFF: render every product on one page
  # (250 is Shopify's maximum page size for paginate).
  if section.settings.enable_load_more
    assign products_per_page = section.settings.products_per_page
  else
    assign products_per_page = 250
  endif
-%}

{%- if show_collection and swatch_collection != blank -%}

  {{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
  {{ 'template-collection.css' | asset_url | stylesheet_tag }}
  {{ 'component-product-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-product-grid.css' | asset_url | stylesheet_tag }}
  {{ 'component-collection-filters.css' | asset_url | stylesheet_tag }}

  <script src="{{ 'collection-filters.js' | asset_url }}" defer="defer"></script>

  {% assign active_tags = '' %}

  {% for tag in current_tags %}
    {% assign tag_as_handle = tag | replace: '&#39;', '' | replace: '&#34;', '' | handle %}
    {% assign active_tags = active_tags | append: tag_as_handle %}

    {% unless forloop.last %}
      {% assign active_tags = active_tags | append: '+' %}
    {% endunless %}
  {% endfor %}

  <link
    rel="preload"
    href="{{ 'component-rte.css' | asset_url }}"
    as="style"
    onload="this.onload=null;this.rel='stylesheet'"
  >

  {% comment %} <noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript> {% endcomment %}

  <div
    class="page-width b2b-swatches-collection"
    data-intelligems-swatches
    data-collection-handle="{{ swatch_collection.handle }}"
  >
    {% unless section.settings.show_title %}
        <h1 class="collection-hero__title--top">
            {{- collection.title | escape -}}
        </h1>
    {% endunless %}

    <div class="collection-grid__inner">
      {% comment %}
        {% if section.settings.enable_filtering or section.settings.enable_sorting %}
          {{ 'component-custom-filters.css' | asset_url | stylesheet_tag }}
          <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

          <div id="main-collection-filters" data-id="{{ section.id }}">
            {% render 'facets',
              results: swatch_collection,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: false,
              collapse_on_larger_devices: section.settings.collapse_on_larger_devices
            %}
          </div>
        {% endif %}
      {% endcomment %}

      {% render 'collection-filters' %}
      <script>
        function clearAll(e) {
          e.preventDefault();
          console.log("clear all")
          document.querySelector('collection-filters').clearAllFilters()
        }
      </script>

      <div id="ProductGridContainer">
        {% if swatch_collection.products.size == 0 %}
          <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>

                {{
                  'sections.collection_template.use_fewer_filters_html' | t
                }}
                <button onclick="clearAll(event)" class="h2 collection-filter-clear-all">clear all</button>.
              </h2>
            </div>
          </div>
        {% else %}
          <div class="collection">
            {%- assign collection_seo_title = swatch_collection.title -%}
            {%- assign collection_seo_url = swatch_collection.url -%}
            {% paginate swatch_collection.products by products_per_page %}
            {%- if section.settings.enable_load_more -%}
              {%- comment -%}
                Reveal paging: the Intelligems script 
              {%- endcomment -%}
              <style id="SwatchReveal-{{ section.id }}">
                #shopify-section-{{ section.id }} #product-grid[data-reveal-paging]:not(:has(> .ig-swatch-hidden)) > .product-grid__item:nth-child(n + {{ paginate.page_size | plus: 1 }}) { display: none; }
                #shopify-section-{{ section.id }} #load-more-wrapper.load-more-wrapper { display: block !important; }
                #shopify-section-{{ section.id }} .collection:has(#product-grid > .ig-swatch-hidden) #load-more-wrapper.load-more-wrapper { display: none !important; }
              </style>
            {%- endif -%}
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="product-grid list-unstyled"
              {%- if section.settings.enable_load_more %}
                data-reveal-paging
                data-reveal-style="SwatchReveal-{{ section.id }}"
                data-page-size="{{ paginate.page_size }}"
                data-offset="{{ paginate.current_offset }}"
                data-total="{{ paginate.items }}"
                data-revealed="{{ paginate.page_size }}"
              {%- endif -%}
            >
                {% for product in swatch_collection.products %}
                  {% comment %} {% render 'product-card', product_card_product: product %} {% endcomment %}
                  {% assign grouped_collection = nil %}
                  {% for product_collection in product.collections %}
                    {% if product_collection.title contains ' |' %}
                      {% assign grouped_collection = product_collection %}
                    {% endif %}
                  {% endfor %}
                  <li class="product-grid__item">
                    {% render 'grouped-product-card',
                      product_card_product: product,
                      collection: grouped_collection,
                      title: grouped_collection.title,
                      button_text: 'Shop Now',
                      card_index: forloop.index,
                      hide_tag: section.settings.hide_tag
                    %}
                  </li>
                {% endfor %}
            </ul>
            <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "ItemList",
              "name": {{ collection_seo_title | json }},
              "url": {{ collection_seo_url | prepend: shop.url | json }},
              "numberOfItems": {{ swatch_collection.products.size | json }},
              "itemListElement": [
                {%- for product in swatch_collection.products -%}
                {
                  "@type": "ListItem",
                  "position": {{ forloop.index | json }},
                  "name": {{ product.title | json }},
                  "url": {{ product.url | prepend: shop.url | json }}
                }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            }
            </script>
              {% render 'collection-load-more', paginate: paginate, enable_load_more: section.settings.enable_load_more %}
          {% endpaginate %}
          </div>
        {% endif %}
      </div>

      <div class="loading-overlay">
        <div class="loading-overlay__spinner">
          <svg
            aria-hidden="true"
            focusable="false"
            role="presentation"
            class="spinner"
            viewBox="0 0 66 66"
            xmlns="http://www.w3.org/2000/svg"
          >
            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
          </svg>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Trade Swatches Collection",
  "tag": "section",
  "class": "collection-grid-section with-spacing b2b-swatches-collection-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_load_more",
      "default": false,
      "label": "Enable load more",
      "info": "Shows a product count and a \"Load more\" button below the grid. When off, all products in the collection are shown at once (up to 250)."
    },
    {
      "type": "paragraph",
      "content": "Collection Banner"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show collection title?"
    },
    {
      "type": "paragraph",
      "content": "Shows only to registered B2B / Trade customers (customer.b2b?). Guests and retail customers never see this grid."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Swatches collection",
      "info": "Select the collection to display. On a collection template, leave blank to use the current collection."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 100,
      "step": 2,
      "default": 50,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label",
      "info": "Number of products loaded per \"Load more\" click. Ignored when load more is off."
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "hide_tag",
      "default": false,
      "label": "Hide Label?"
    },
    {
      "type": "checkbox",
      "id": "add_image_padding",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.add_image_padding.label"
    },
    {
      "type": "checkbox",
      "id": "show_image_outline",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.show_image_outline.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label",
      "info": "t:sections.main-collection-product-grid.settings.show_rating.info"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "checkbox",
      "id": "collapse_on_larger_devices",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.collapse_on_larger_devices.label"
    }
  ],
  "presets": [
    {
      "name": "Trade Swatches Collection"
    }
  ]
}
{% endschema %}
