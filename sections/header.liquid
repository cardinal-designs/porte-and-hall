{{ 'component-cart-drawer.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>

{% liquid
  # Top level navigation always comes from the selected menu (Shopify Navigation).
  # "Mega menu" blocks only add dropdown content to the menu item they are named after.
  assign main_menu = section.settings.menu
  if customer and customer.b2b? and section.settings.b2b_menu != blank
    assign main_menu = section.settings.b2b_menu
  endif
%}

<header class="header">
  <div class="header--{{ section.settings.logo_position }} header--inner page-width">
    <!-- Logo -->
    <div class="header__logo">
      <a href="{{ shop.url }}" class="header__logo-link" aria-label="Header logo">
        <div class="header__logo-wrapper">
          {% if section.settings.svg_logo != blank %}
            <div class="header__svg-logo">
              {{ section.settings.svg_logo }}
            </div>
          {% else %}
            {% if section.settings.logo != blank %}
              {% assign image_size = section.settings.logo_width | append: 'x' %}
              <img
                srcset="{{ section.settings.logo | img_url: image_size }} 1x, {{ section.settings.logo | img_url: image_size, scale: 2 }} 2x"
                src="{{ section.settings.logo | img_url: image_size }}"
                loading="lazy"
                class="header__heading-logo"
                width="{{ section.settings.logo.width }}"
                height="{{ section.settings.logo.height }}"
                alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              >
            {% else %}
              <span class="h2">{{ shop.name }}</span>
            {% endif %}
          {% endif %}
        </div>
      </a>
    </div>

    <style>
      .header__logo {
        width: {{ section.settings.logo_width }}px;
      }

      @media screen and (max-width: 768px) {
        .header__logo {
          width: {{ section.settings.mobile_logo_width }}px;
        }
      }
    </style>

    <!-- Icons -->
    {%- unless page.handle == 'the-insider' -%}
      <div class="header__icons">
        {% if section.settings.enable_search %}
          <button class="js-open-search header__icon header__icon--search header__icon--desktop-only" aria-label="Open Search Bar">
            {% render 'icon', icon: 'search' %}
          </button>
        {% endif %}

        {% if shop.customer_accounts_enabled %}
          {% unless page.handle == 'outdoor' %}
          <a
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            class="header__icon header__icon--account hide-mobile"
          >
            {%- liquid
              if customer
                assign account_text = 'customer.account_fallback' | t
                if section.settings.account_label != blank
                  assign account_text = section.settings.account_label
                endif
              else
                assign account_text = 'customer.log_in' | t
                if section.settings.login_label != blank
                  assign account_text = section.settings.login_label
                endif
              endif
            -%}
            <span class="header__icon-text">{{ account_text | escape }}</span>
            <span class="header__icon-graphic">
              {% render 'icon', icon: 'account' %}
              <span class="visually-hidden">{{ account_text | escape }}</span>
            </span>
          </a>
          {% endunless %}
        {% endif %}

        {% if section.settings.trade_label != blank and section.settings.trade_link != blank %}
          <a href="{{ section.settings.trade_link }}" class="header__icon header__icon--trade header__icon--desktop-only">
            <span class="header__icon-text">{{ section.settings.trade_label | escape }}</span>
          </a>
        {% endif %}

        {% if template != 'cart' %}
          <button
            class="js-open-cart header__icon header__icon--cart"
            id="cart-icon-bubble"
            aria-label="Open Cart Drawer"
          >
            {% render 'icon', icon: 'cart' %}
            <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
            {% if cart != empty %}
              <div class="cart-count-bubble">
                {% if cart.item_count < 100 %}
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                {% endif %}
                <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
              </div>
            {% endif %}
          </button>
        {% else %}
          <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart" id="cart-icon-bubble">
            {% render 'icon', icon: 'cart' %}
            <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
            {% if cart != empty %}
              <div class="cart-count-bubble">
                {% if cart.item_count < 100 %}
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                {% endif %}
                <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
              </div>
            {% endif %}
          </a>
        {% endif %}

        {% if main_menu != blank %}
          <button class="js-open-menu header__icon header__icon--menu" aria-label="Menu">
            {% render 'icon', icon: 'hamburger' %}
          </button>
        {% endif %}
      </div>
    {%- endunless -%}

    {% if section.settings.enable_search %}
      <div class="header__search">
        <div class="page-width">
          <div class="header__search-container">
            <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form">
              <div class="header__search-group">
                <input
                  class="header__search-input"
                  id="Search-In-Modal"
                  type="search"
                  name="q"
                  value="{{ search.terms | escape }}"
                  placeholder="Search..."
                >
                <input type="hidden" name="options[prefix]" value="last">
                <button class="header__search-button" aria-label="{{ 'general.search.search' | t }}">
                  {% render 'icon', icon: 'search' %}
                </button>
              </div>
            </form>
            <button class="js-close-search header__search-close">
              {% render 'icon', icon: 'close' %}
            </button>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
{% unless page.handle == 'outdoor' or page.handle == 'the-insider' %}
  <div class="header__navigation">
    <!-- Navigation -->
    {% if main_menu != blank %}
      <nav class="header__menu header__menu--mega" aria-label="{{ 'sections.header.menu' | t }}">
        <ul class="header__menu-list" role="list">
          {% for link in main_menu.links %}
            {%- liquid
              assign downcased_link_title = link.title | downcase | strip

              # Find the "Mega menu" block attached to this menu item. All dropdown
              # content lives in that block's own settings - no child blocks.
              assign mega_block = nil
              for block in section.blocks
                if block.type == 'mega_menu'
                  assign block_title = block.settings.title | downcase | strip
                  if block_title != blank and block_title == downcased_link_title
                    assign mega_block = block
                    break
                  endif
                endif
              endfor

              assign mega_view_all = ''
              assign mega_filters = ''
              assign mega_images = ''

              if mega_block
                assign mega_settings = mega_block.settings

                if mega_settings.view_all_label != blank
                  capture mega_view_all
                    echo '<li>'
                    if mega_settings.view_all_link != blank
                      echo '<a href="' | append: mega_settings.view_all_link | append: '"'
                    else
                      echo '<span'
                    endif
                    echo ' class="header__mega-menu-group-link--additional">'
                    echo mega_settings.view_all_label | escape
                    if mega_settings.view_all_link != blank
                      echo '</a>'
                    else
                      echo '</span>'
                    endif
                    echo '</li>'
                  endcapture
                endif

                for i in (1..4)
                  assign label_key = 'filter_' | append: i | append: '_label'
                  assign link_key = 'filter_' | append: i | append: '_link'
                  assign filter_label = mega_settings[label_key]
                  assign filter_link = mega_settings[link_key]

                  if filter_label != blank
                    capture filter_html
                      echo '<li>'
                      if filter_link != blank
                        echo '<a href="' | append: filter_link | append: '"'
                      else
                        echo '<span'
                      endif
                      echo ' class="header__mega-menu-filter">'
                      echo filter_label | escape
                      if filter_link != blank
                        echo '</a>'
                      else
                        echo '</span>'
                      endif
                      echo '</li>'
                    endcapture
                    assign mega_filters = mega_filters | append: filter_html
                  endif
                endfor

                for i in (1..6)
                  assign image_key = 'image_' | append: i
                  assign badge_key = 'badge_' | append: i
                  assign subtitle_key = 'subtitle_' | append: i
                  assign title_key = 'title_' | append: i
                  assign text_key = 'text_' | append: i
                  assign link_label_key = 'link_label_' | append: i
                  assign link_key = 'link_' | append: i

                  assign image_title = mega_settings[title_key]
                  assign image_subtitle = mega_settings[subtitle_key]

                  if mega_settings[image_key] != blank or image_title != blank or image_subtitle != blank
                    capture image_html
                      render 'header-mega-menu-image', layout: mega_settings.mega_layout, image: mega_settings[image_key], badge: mega_settings[badge_key], subtitle: image_subtitle, title: image_title, text: mega_settings[text_key], link_label: mega_settings[link_label_key], link: mega_settings[link_key]
                    endcapture
                    assign mega_images = mega_images | append: image_html
                  endif
                endfor
              endif

              assign has_mega = false
              if mega_block and link.links != blank
                assign has_mega = true
              endif
              if mega_block and mega_images != blank
                assign has_mega = true
              endif
              if mega_block and mega_view_all != blank
                assign has_mega = true
              endif
              if mega_block and mega_filters != blank
                assign has_mega = true
              endif

              assign mega_heading = ''
              if has_mega
                assign mega_heading = mega_block.settings.mega_heading | default: link.title
              endif

              assign highlight_title = section.settings.highlight_title | downcase | strip
              assign is_highlighted = false
              if highlight_title != blank and highlight_title == downcased_link_title
                assign is_highlighted = true
              endif
            -%}

            {%- capture item_style -%}
              {%- if is_highlighted and section.settings.highlight_color != blank -%}
                style="--menu-item-color: {{ section.settings.highlight_color }};"
              {%- endif -%}
            {%- endcapture -%}
            {%- capture item_class -%}
              header__menu-item{% if is_highlighted %} header__menu-item--highlighted{% endif %}
            {%- endcapture -%}

            {% if has_mega %}
              <li class="header__mega-menu-wrapper" data-mega-menu>
                <a
                  href="{{ link.url }}"
                  class="{{ item_class | strip }} header__menu-item--mega"
                  {{ item_style }}
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>

                <button
                  type="button"
                  class="header__menu-toggle"
                  aria-expanded="false"
                  aria-controls="MegaMenu-{{ mega_block.id }}"
                  aria-label="{{ link.title | escape }}"
                >
                  {% render 'icon', icon: 'caret' %}
                </button>

                <div class="header__mega-menu-outer" id="MegaMenu-{{ mega_block.id }}" {{ mega_block.shopify_attributes }}>
                  <div class="header__mega-menu">
                    <div class="page-width">
                      <div class="header__mega-menu-container header__mega-menu-container--{{ mega_block.settings.mega_layout }}">
                        {% if mega_block.settings.mega_layout == 'grid' %}
                          <div class="header__mega-menu-grid-wrapper">
                            {% if mega_heading != blank %}
                              <p class="header__mega-menu-group-title">{{ mega_heading | escape }}</p>
                            {% endif %}

                            {% if mega_images != blank %}
                              <ul class="header__mega-menu-cards" role="list">
                                {{ mega_images }}
                              </ul>
                            {% endif %}

                            {% if link.links != blank or mega_view_all != blank %}
                              <ul class="header__mega-menu-group-links header__mega-menu-group-links--inline" role="list">
                                {% for childlink in link.links %}
                                  <li>
                                    <a
                                      href="{{ childlink.url }}"
                                      class="header__mega-menu-group-link"
                                      {% if childlink.current %}
                                        aria-current="page"
                                      {% endif %}
                                    >
                                      {{ childlink.title | escape }}
                                    </a>
                                  </li>
                                {% endfor %}
                                {{ mega_view_all }}
                              </ul>
                            {% endif %}

                            {% if mega_filters != blank %}
                              {% render 'header-mega-menu-filters',
                                heading: mega_block.settings.filters_heading,
                                items: mega_filters
                              %}
                            {% endif %}
                          </div>
                        {% else %}
                          <div class="header__mega-menu-panel-main">
                            <div class="header__mega-menu-links">
                              {%- liquid
                                # Menu items with a third level keep the legacy column layout,
                                # otherwise the child links are shown as a single list.
                                assign has_grandchildren = false
                                for childlink in link.links
                                  if childlink.links != blank
                                    assign has_grandchildren = true
                                    break
                                  endif
                                endfor
                              -%}

                              {% if has_grandchildren %}
                                {% for childlink in link.links %}
                                  <div class="header__mega-menu-group">
                                    <p class="header__mega-menu-group-title">{{ childlink.title | escape }}</p>
                                    <ul class="header__mega-menu-group-links" role="list">
                                      {% for grandchildlink in childlink.links %}
                                        <li>
                                          <a
                                            href="{{ grandchildlink.url }}"
                                            class="header__mega-menu-group-link"
                                            {% if grandchildlink.current %}
                                              aria-current="page"
                                            {% endif %}
                                          >
                                            {{ grandchildlink.title | escape }}
                                          </a>
                                        </li>
                                      {% endfor %}
                                      {% if forloop.first %}
                                        {{ mega_view_all }}
                                      {% endif %}
                                    </ul>
                                  </div>
                                {% endfor %}
                              {% else %}
                                <div class="header__mega-menu-group">
                                  {% if mega_heading != blank %}
                                    <p class="header__mega-menu-group-title">{{ mega_heading | escape }}</p>
                                  {% endif %}
                                  <ul class="header__mega-menu-group-links" role="list">
                                    {% for childlink in link.links %}
                                      <li>
                                        <a
                                          href="{{ childlink.url }}"
                                          class="header__mega-menu-group-link"
                                          {% if childlink.current %}
                                            aria-current="page"
                                          {% endif %}
                                        >
                                          {{ childlink.title | escape }}
                                        </a>
                                      </li>
                                    {% endfor %}
                                    {{ mega_view_all }}
                                  </ul>
                                </div>
                              {% endif %}
                            </div>

                            {% if mega_filters != blank %}
                              {% render 'header-mega-menu-filters',
                                heading: mega_block.settings.filters_heading,
                                items: mega_filters
                              %}
                            {% endif %}
                          </div>

                          {% if mega_images != blank %}
                            <ul class="header__mega-menu-blocks" role="list">
                              {{ mega_images }}
                            </ul>
                          {% endif %}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            {% elsif link.links != blank %}
              <li>
                <div class="header__menu-item header__menu-item--has-dropdown">
                  <span
                    class="{{ item_class | strip }}{% if link.child_active %} header__active-menu-item{% endif %}"
                    {{ item_style }}
                  >
                    {{- link.title | escape -}}
                  </span>
                  {% render 'icon', icon: 'caret' %}
                </div>
                <ul class="header__submenu" role="list" tabindex="-1">
                  {% for childlink in link.links %}
                    <li>
                      <a
                        href="{{ childlink.url }}"
                        class="header__submenu-item{% if childlink.current %} header__submenu-item--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </li>
            {% else %}
              <li>
                <a
                  href="{{ link.url }}"
                  class="{{ item_class | strip }}"
                  {{ item_style }}
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ link.title | escape }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
        <div class="header__mega-menu-overlay" data-mega-menu-overlay></div>
      </nav>
    {% endif %}
  </div>
  {% endunless %}
</header>

{%- capture sameas_urls -%}
  {%- if settings.social_twitter_link != blank -%}{{ settings.social_twitter_link }},{%- endif -%}
  {%- if settings.social_facebook_link != blank -%}{{ settings.social_facebook_link }},{%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}{{ settings.social_pinterest_link }},{%- endif -%}
  {%- if settings.social_instagram_link != blank -%}{{ settings.social_instagram_link }},{%- endif -%}
  {%- if settings.social_tumblr_link != blank -%}{{ settings.social_tumblr_link }},{%- endif -%}
  {%- if settings.social_snapchat_link != blank -%}{{ settings.social_snapchat_link }},{%- endif -%}
  {%- if settings.social_youtube_link != blank -%}{{ settings.social_youtube_link }},{%- endif -%}
  {%- if settings.social_vimeo_link != blank -%}{{ settings.social_vimeo_link }}{%- endif -%}
{%- endcapture %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo %}
      {% assign image_size = section.settings.logo.width | append: 'x' %}
      "logo": {{ section.settings.logo | img_url: image_size | prepend: "https:" | json }},
    {%- endif -%}
    {%- assign sameas_array = sameas_urls | split: ',' -%}
    {%- if sameas_array != blank -%}
    "sameAs": [
      {%- for url in sameas_array %}
      "{{ url | strip }}"{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor %}
    ],
    {%- endif %}
    "url": {{ shop.url | append: page.url | json }}
  }
</script>

{% if request.page_type == 'index' %}
  {% assign potential_action_target = shop.url | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ shop.url | append: page.url | json }}
    }
  </script>
{% endif %}

{% javascript %}
  const openSearch = document.querySelector('.js-open-search');
  const closeSearch = document.querySelector('.js-close-search');
  const search = document.querySelector('.header__search');

  if(openSearch) {
    openSearch.addEventListener('click', () => {
    if (search.classList.contains('is-visible')) {
      search.classList.remove('is-visible');
    } else {
      search.classList.add('is-visible');
    }
  });
  }

  if(closeSearch) {
    closeSearch.addEventListener('click', () => {
    search.classList.remove('is-visible');
  });
  }

  /* Desktop mega menu (block-based navigation) */
  (() => {
    const CLOSE_DELAY = 150;

    const initMegaMenu = (nav) => {
      if (!nav || nav.dataset.megaMenuReady) return;
      nav.dataset.megaMenuReady = 'true';

      const items = nav.querySelectorAll('[data-mega-menu]');
      const overlay = nav.querySelector('[data-mega-menu-overlay]');
      let closeTimer;

      const setOpen = (item, isOpen) => {
        item.classList.toggle('is-open', isOpen);
        item.querySelector('.header__menu-toggle').setAttribute('aria-expanded', isOpen);
        nav.classList.toggle('has-open-mega-menu', !!nav.querySelector('[data-mega-menu].is-open'));
      };

      const open = (item) => {
        clearTimeout(closeTimer);
        items.forEach((other) => other !== item && setOpen(other, false));
        setOpen(item, true);
      };

      const closeAll = () => {
        clearTimeout(closeTimer);
        items.forEach((item) => setOpen(item, false));
      };

      items.forEach((item) => {
        const toggle = item.querySelector('.header__menu-toggle');
        const topLink = item.querySelector('a.header__menu-item');
        let openedByTouch = false;

        item.addEventListener('mouseenter', () => open(item));
        item.addEventListener('mouseleave', () => {
          clearTimeout(closeTimer);
          closeTimer = setTimeout(() => setOpen(item, false), CLOSE_DELAY);
        });

        toggle.addEventListener('click', () => {
          if (openedByTouch || !item.classList.contains('is-open')) {
            openedByTouch = false;
            open(item);
          } else {
            setOpen(item, false);
          }
        });

        // On touch devices the first tap opens the panel, the second follows the link.
        item.addEventListener('pointerdown', (event) => {
          openedByTouch = event.pointerType !== 'mouse' && !item.classList.contains('is-open');
        });
        if (topLink) {
          topLink.addEventListener('click', (event) => {
            if (!openedByTouch) return;
            openedByTouch = false;
            event.preventDefault();
            open(item);
          });
        }

        item.addEventListener('focusout', (event) => {
          if (!item.contains(event.relatedTarget)) setOpen(item, false);
        });

        item.addEventListener('keyup', (event) => {
          if (event.code !== 'Escape' || !item.classList.contains('is-open')) return;
          setOpen(item, false);
          toggle.focus();
        });
      });

      if (overlay) overlay.addEventListener('click', closeAll);

      document.addEventListener('click', (event) => {
        if (!nav.contains(event.target)) closeAll();
      });

      // Theme editor: keep the panel of the selected block open while it is being edited.
      document.addEventListener('shopify:block:select', (event) => {
        const item = event.target.closest('[data-mega-menu]');
        if (item && nav.contains(item)) open(item);
      });
      document.addEventListener('shopify:block:deselect', (event) => {
        if (nav.contains(event.target)) closeAll();
      });
    };

    initMegaMenu(document.querySelector('.header__menu--mega'));

    document.addEventListener('shopify:section:load', (event) => {
      initMegaMenu(event.target.querySelector('.header__menu--mega'));
    });
  })();

{% endjavascript %}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "textarea",
      "id": "svg_logo",
      "label": "SVG Logo",
      "info": "Optional. This will override logo image picker."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100,
      "unit": "px",
      "label": "Mobile Logo Width"
    },
    {
      "type": "select",
      "id": "logo_position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left",
      "label": "Logo Position"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "link_list",
      "id": "b2b_menu",
      "label": "B2B Menu"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "Enable Search",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop header links"
    },
    {
      "type": "text",
      "id": "login_label",
      "label": "Login label",
      "default": "Login",
      "info": "Shown on desktop instead of the account icon when the customer is logged out."
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Account label",
      "default": "Account",
      "info": "Shown on desktop instead of the account icon when the customer is logged in."
    },
    {
      "type": "text",
      "id": "trade_label",
      "label": "Trade label",
      "default": "Trade"
    },
    {
      "type": "url",
      "id": "trade_link",
      "label": "Trade link"
    },
    {
      "type": "header",
      "content": "Menu item highlight"
    },
    {
      "type": "text",
      "id": "highlight_title",
