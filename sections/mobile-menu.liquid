{% liquid
  assign mobile_menu = section.settings.menu
  if customer and customer.b2b? and section.settings.b2b_menu != blank
    assign mobile_menu = section.settings.b2b_menu
  endif
%}

<style>
  .menu-drawer__menu-item-content {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .menu-drawer__menu-item-content .header__menu-item-icon {
    display: block;
    width: auto;
    height: var(--menu-item-icon-height, 20px);
  }

  {% for block in section.blocks %}
    {% if block.type == 'nav_item_style' %}
      .menu-drawer__menu-item--{{ block.id }} {
        --menu-item-icon-height: {{ block.settings.icon_height }}px;
        {% if block.settings.text_color != blank %}
          color: {{ block.settings.text_color }};
        {% endif %}
        {% case block.settings.font %}
          {% when 'louize' %}
            font-family: louize, serif;
            font-weight: 500;
          {% when 'brandon_bold' %}
            font-family: brandon, sans-serif;
            font-weight: 600;
          {% else %}
            font-family: brandon, sans-serif;
            font-weight: 400;
        {% endcase %}
      }
    {% endif %}
  {% endfor %}
</style>

<menu-drawer>
  <div
    class="menu-drawer"
    id="menu-drawer"
    aria-hidden="true"
    aria-modal="true"
    aria-label="Menu Drawer"
    role="dialog"
    tabindex="-1"
  >
    <div class="menu-drawer__inner">
      <div class="menu-drawer__header">
        <p class="menu-drawer__title h4 visually-hidden">Menu</p>
        <button class="js-close-menu menu-drawer__close">
          {% render 'icon', icon: 'close' %}
        </button>
      </div>
      <div class="menu-drawer__content">
        <ul class="menu-drawer__menu list-unstyled" role="list">
          {% for link in mobile_menu.links %}
            {% assign downcased_link_title = link.title | downcase | strip %}
            {% assign item_style = nil %}
            {% for block in section.blocks %}
              {% if block.type == 'nav_item_style' and item_style == nil %}
                {% assign style_menu_item = block.settings.menu_item | strip | downcase %}
                {% if style_menu_item != blank and style_menu_item == downcased_link_title %}
                  {% assign item_style = block %}
                {% endif %}
              {% endif %}
            {% endfor %}

            {% capture link_content %}
              {%- if item_style != nil -%}
                <span class="menu-drawer__menu-item-content menu-drawer__menu-item--{{ item_style.id }}">
                  {%- render 'header-menu-item-content', title: link.title, item_style: item_style -%}
                </span>
              {%- else -%}
                {{ link.title }}
              {%- endif -%}
            {% endcapture %}

            {% if link.title == 'Swatches' %}
              {% if customer and customer.b2b? %}
              <li>
              {% if link.links != blank %}
                <button class="menu-drawer__menu-button menu-drawer__menu-button--has-menu body" href="{{ link.url }}">
                  {{ link_content }}
                  {% render 'icon', icon: 'caret' %}
                </button>
                <ul class="menu-drawer__secondary-menu list-unstyled" role="list">
                  {% for child_link in link.links %}
                    <li>
                      <a class="menu-drawer__secondary-menu-button body" href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <a class="menu-drawer__menu-button body" href="{{ link.url }}">{{ link_content }}</a>
              {% endif %}
            </li>
              {% endif %}
            {% else %}
            <li>
              {% if link.links != blank %}
                <button class="menu-drawer__menu-button menu-drawer__menu-button--has-menu body" href="{{ link.url }}">
                  {{ link_content }}
                  {% render 'icon', icon: 'caret' %}
                </button>
                <ul class="menu-drawer__secondary-menu list-unstyled" role="list">
                  {% for child_link in link.links %}
                    <li>
                      <a class="menu-drawer__secondary-menu-button body" href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <a class="menu-drawer__menu-button body" href="{{ link.url }}">{{ link_content }}</a>
              {% endif %}
            </li>
            {%endif %}
          {% endfor %}

          <li>
            {% if shop.customer_accounts_enabled %}
              <a
                href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
                class="header__icon header__icon--account"
              >
                {% render 'icon', icon: 'account' %}
                <span class="visually-hidden">
                  {% liquid
                    if customer
                      echo 'customer.account_fallback' | t
                    else
                      echo 'customer.log_in' | t
                    endif
                  %}
                </span>
              </a>
            {% endif %}
          </li>
        </ul>
      </div>
    </div>
  </div>
</menu-drawer>

{% schema %}
{
  "name": "Mobile Menu",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "link_list",
      "id": "b2b_menu",
      "label": "B2B Menu"
    }
  ],
  "blocks": [
    {
      "type": "nav_item_style",
      "name": "Nav Item Style",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu Item",
          "info": "Enter the menu item title exactly as it appears in the menu (not case sensitive)."
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Font Color",
          "info": "Leave empty to use the default nav color."
        },
        {
          "type": "select",
          "id": "font",
          "label": "Font",
          "options": [
            {
              "value": "louize",
              "label": "Louize"
            },
            {
              "value": "brandon_bold",
              "label": "Brandon Bold"
            },
            {
              "value": "brandon_regular",
              "label": "Brandon Regular"
            }
          ],
          "default": "brandon_regular"
        },
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "select",
          "id": "icon_position",
          "label": "Icon Position",
          "options": [
            {
              "value": "left",
              "label": "Left of text"
            },
            {
              "value": "right",
              "label": "Right of text"
            }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "icon_height",
          "min": 10,
          "max": 60,
          "step": 1,
          "default": 20,
          "unit": "px",
          "label": "Icon Height"
        }
      ]
    }
  ]
}
{% endschema %}
