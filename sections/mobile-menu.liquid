{% comment %}
  Mobile menu drawer shell. It stays outside the header (the header wrapper has its own
  stacking context, which would put the drawer under the page overlay).
  The content - navigation, mega menu content, Login and Trade - is rendered by the Header
  section from Header -> Menu and its "Mega menu" blocks (<template id="MobileMenuContent">)
  and cloned into [data-mobile-menu-content] by MenuDrawer in global.js.
{% endcomment %}

<menu-drawer>
  <div
    class="menu-drawer menu-drawer--mega"
    id="menu-drawer"
    aria-hidden="true"
    aria-modal="true"
    aria-label="Menu Drawer"
    role="dialog"
    tabindex="-1"
  >
    <div class="menu-drawer__inner" data-mobile-menu-content>
      <div class="menu-drawer__header">
        <p class="menu-drawer__title h4 visually-hidden">Menu</p>
        <button type="button" class="js-close-menu menu-drawer__close" aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon', icon: 'close' %}
        </button>
      </div>
    </div>
  </div>
</menu-drawer>

{% schema %}
{
  "name": "Mobile Menu",
  "settings": [
    {
      "type": "paragraph",
      "content": "The mobile menu uses the Header section: Header → Menu for the navigation (including the B2B menu) and the Header \"Mega menu\" blocks for the Shop Indoor / Shop Outdoor / Our Collections content, plus the Login and Trade labels."
    }
  ]
}
{% endschema %}
