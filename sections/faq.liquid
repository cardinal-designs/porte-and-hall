{{ 'section-faq.css' | asset_url | stylesheet_tag }}

{%- liquid

  assign visibility_field = 'show_on_faq_page'
  if template.name == 'product'
    assign visibility_field = 'show_on_product_page_faq_section'
  endif
  assign faq_entries = section.settings.collection.metafields.custom.faqs.value

  assign hidden_blocks = ','
  assign visible_count = 0
  for block in section.blocks
    assign block_hidden = false
    if faq_entries != blank and block.settings.title != blank
      for entry in faq_entries
        if entry.question.value == block.settings.title
          if entry[visibility_field].value == false
            assign block_hidden = true
          endif
          break
        endif
      endfor
    endif
    if block_hidden
      assign hidden_blocks = hidden_blocks | append: forloop.index | append: ','
    else
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- if visible_count > 0 -%}
<div class="page-width" id="{{ section.settings.anchor }}">
  <div class="faq__inner">
    <h2 class="faq__heading">{{ section.settings.heading | default: 'FAQ' }}</h2>

    {% assign column_break = visible_count | divided_by: 2.0 | ceil %}
    {% assign visible_index = 0 %}
    <div class="faq__wrapper">
      <div class="faq__column">
      {% for block in section.blocks %}
        {% assign block_key = ',' | append: forloop.index | append: ',' %}
        {% if hidden_blocks contains block_key %}{% continue %}{% endif %}
        {% assign visible_index = visible_index | plus: 1 %}
        <div class="faq__item">
          <button class="faq__question body" data-faq="{{ visible_index }}">
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}
            
            {% if block.settings.title_richtext != blank %}
              {{ block.settings.title_richtext }}
            {% endif %}
            <span>{% render 'icon', icon: 'accordion' %}</span>
          </button>
          <div class="faq__content body">
            {{ block.settings.answer }}
          </div>
        </div>
        {% if column_break == visible_index %}
        </div>
        <div class="faq__column">
        {% endif %}
      {% endfor %}
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% if content_for_header contains '"faq_schema_printed"' %}
  {% assign faq_schema_already_printed = true %}
{% else %}
  {% assign faq_schema_already_printed = false %}
{% endif %}

{% if visible_count > 0 and faq_schema_already_printed == false %}
  {% capture faq_schema %}"faq_schema_printed": true{% endcapture %}
  <script>
    window.faqSchemaPrinted = true;
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- assign schema_first = true -%}
      {% for block in section.blocks %}
      {%- assign block_key = ',' | append: forloop.index | append: ',' -%}
      {%- if hidden_blocks contains block_key %}{% continue %}{% endif -%}
      {%- unless schema_first %},{% endunless -%}
      {%- assign schema_first = false %}
      {
        "@type": "Question",
        "name": {{ block.settings.title | default: block.settings.title_richtext | strip_html | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.answer | strip_html | json }}
        }
      }
      {% endfor %}
    ]
  }
  </script>
{% endif %}





{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "faq with-spacing",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "(Optional) Anchor Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Connect collection for metafield access to FAQs"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Frequently Asked Question",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "title_richtext",
          "label": "Question richtext"
        },        
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
